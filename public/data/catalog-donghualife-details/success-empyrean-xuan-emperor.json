{"series":{"id":"success-empyrean-xuan-emperor","slug":"success-empyrean-xuan-emperor","title":"Success Empyrean Xuan Emperor","image":"https://donghualife.com/sites/default/files/styles/node_series/public/2025-02/upscalemedia-transformed_0.jpeg?itok=3kTDsCo3","synopsis":"Wang Fan, que posee la Técnica del Emperador Xuan, era originalmente un estudiante ordinario de la Academia Huang Jin. Para vengar a su hermano, se puso la máscara de rey tigre de plata. Desde entonces, ¡hay un rey tigre de plata que amenaza al mundo! Mi nombre es Wang Fan, el rey del rey, el ordinario Fan. Al ponerse la máscara, Él es el rey del tigre de plata. Al quitarse la máscara, Él es el Wang Fan ordinario.","status":"En Emisión","year":2021,"genres":[],"type":"donghua","src":"donghualife","sourceUrls":["https://donghualife.com/series/success-empyrean-xuan-emperor"],"updatedAt":"2026-09-19T17:20:12.587Z"},"seasons":[{"id":"success-empyrean-xuan-emperor-t1","slug":"success-empyrean-xuan-emperor-t1","seriesId":"success-empyrean-xuan-emperor","number":1,"image":"https://donghualife.com/sites/default/files/styles/node_series/public/2025-02/upscalemedia-transformed_0.jpeg?itok=3kTDsCo3","updatedAt":"2026-09-19T17:20:12.587Z","episodeCount":50}],"episodes":[{"id":"success-empyrean-xuan-emperor-t1-e248","slug":"success-empyrean-xuan-emperor-t1-e248","title":"success-empyrean-xuan-emperor-1-episodio-x248","sourceUrl":"https://donghualife.com/episode/success-empyrean-xuan-emperor-1-episodio-x248","servers":[{"name":"rumble.com","url":"https://rumble.com/embed/v79xhlq/?pub=4m2typ","embed":true},{"name":"geo.dailymotion.com","url":"https://geo.dailymotion.com/player.html?video=k7nzbpDVgfmVSxHedVU","embed":true}],"seriesId":"success-empyrean-xuan-emperor","seasonId":"success-empyrean-xuan-emperor-t1","number":248,"updatedAt":"2026-09-19T17:33:15.045Z"},{"id":"success-empyrean-xuan-emperor-t1-e247","slug":"success-empyrean-xuan-emperor-t1-e247","title":"success-empyrean-xuan-emperor-1-episodio-x247","sou