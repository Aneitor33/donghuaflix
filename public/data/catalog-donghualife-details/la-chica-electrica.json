{"series":{"id":"la-chica-electrica","slug":"la-chica-electrica","title":"La Chica Electrica","image":"https://donghualife.com/sites/default/files/styles/node_series/public/2025-03/unnamed%20%281%29_0.jpg?itok=aKTQn26b","synopsis":"Liang Xigua es un joven pobre que lucha por ganarse la vida en las grietas de la ciudad. Un día, su viejo refrigerador, que lo había acompañado durante muchos veranos solitarios, tomó forma humana e intervino en su vida. Se enfrentan por la comida, luchan para llegar a fin de mes, se arrastran hacia abajo y se apoyan mutuamente, lo que da como resultado muchas historias diarias ridículas. Xigua poco a poco se da cuenta de que no es el único que ha despertado la vida del aparato.","status":"En Emisión","year":2023,"genres":[],"type":"donghua","src":"donghualife","sourceUrls":["https://donghualife.com/series/la-chica-electrica"],"updatedAt":"2026-09-19T16:49:03.154Z"},"seasons":[{"id":"la-chica-electrica-t1","slug":"la-chica-electrica-t1","seriesId":"la-chica-electrica","number":1,"image":"https://donghualife.com/sites/default/files/styles/node_series/public/2025-03/unnamed%20%281%29_0.jpg?itok=aKTQn26b","updatedAt":"2026-09-19T16:49:03.154Z","episodeCount":12}],"episodes":[{"id":"la-chica-electrica-t1-e12","slug":"la-chica-electrica-t1-e12","title":"la-chica-electrica-1-episodio-x12","sourceUrl":"https://donghualife.com/episode/la-chica-electrica-1-episodio-x12","servers":[{"name":"ok.ru","url":"https://ok.ru/videoembed/6407548439073","embed":true}],"seriesId":"la-chica-electrica","seasonId":"la-chica-electrica-t1","number":12,"updatedAt":"2026-09-19T17:10:36.158Z"},{"id":"la-chica-electrica-t1-e11","slug":"la-chica-electrica-t1-e11","title":"la-chica-electrica-1-episodio-x11","sourceUrl":"https://donghualife.com/episode/la-chica-electrica-1-episodio-x11","servers":[{"name":"ok.ru","url":"https://ok.ru/videoembed/5676236671521","embed":true}],"seriesId":"la-chica-electrica","seasonId":"la-chica-electrica-t1","number":11,"updatedAt":"2026-0