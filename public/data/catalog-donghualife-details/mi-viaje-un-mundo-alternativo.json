{"series":{"id":"mi-viaje-un-mundo-alternativo","slug":"mi-viaje-un-mundo-alternativo","title":"Mi Viaje Un Mundo Alternativo","image":"https://donghualife.com/sites/default/files/styles/poster/public/2024-11/mvo%20ag.jpg?itok=80kyAuQ7","synopsis":"Cuando el joven Chen Xiaofan entra en el otro mundo por error, se convierte en el joven maestro de la familia Chen, el hombre más bello de la ciudad de Muyun, que vive de su cara. Descubre que, aunque es amado por todas las mujeres de la ciudad de Muyun, es un perdedor incapaz de cultivar. Para volver a su antiguo mundo, abandona su apacible vida de joven maestro, resiste la fuerte oposición de su familia y emprende con decisión el camino del cultivo.","status":"En Emisión","year":2022,"genres":[],"type":"donghua","src":"donghualife","sourceUrls":["https://donghualife.com/series/mi-viaje-un-mundo-alternativo"],"updatedAt":"2026-09-19T17:20:12.579Z"},"seasons":[{"id":"mi-viaje-un-mundo-alternativo-t1","slug":"mi-viaje-un-mundo-alternativo-t1","seriesId":"mi-viaje-un-mundo-alternativo","number":1,"image":"https://donghualife.com/sites/default/files/styles/poster/public/2024-11/mvo%20ag.jpg?itok=80kyAuQ7","updatedAt":"2026-09-19T17:20:12.579Z","episodeCount":40}],"episodes":[{"id":"mi-viaje-un-mundo-alternativo-t1-e40","slug":"mi-viaje-un-mundo-alternativo-t1-e40","title":"mi-viaje-un-mundo-alternativo-1-x40","sourceUrl":"https://donghualife.com/episode/mi-viaje-un-mundo-alternativo-1-x40","servers":[{"name":"ok.ru","url":"https://ok.ru/videoembed/3404740758234","embed":true}],"seriesId":"mi-viaje-un-mundo-alternativo","seasonId":"mi-viaje-un-mundo-alternativo-t1","number":40,"updatedAt":"2026-09-19T17:29:15.862Z"},{"id":"mi-viaje-un-mundo-alternativo-t1-e39","slug":"mi-viaje-un-mundo-alternativo-t1-e39","title":"mi-viaje-un-mundo-alternativo-1-x39","sourceUrl":"https://donghualife.com/episode/mi-viaje-un-mundo-alternativo-1-x39","servers":[{"name":"ok.ru","url":"https://ok.ru/videoembed/3381675231962","embed":true}],"series