{"series":{"id":"i-annoyed-millions-cultivators","slug":"i-annoyed-millions-cultivators","title":"I Annoyed Millions Cultivators","image":"https://donghualife.com/sites/default/files/styles/node_series/public/2024-12/anno%20bban.jpg?itok=il6a5fZ5","synopsis":"Sinopsis.La historia trata sobre un estudiante, Jiang Bei, que luchó valientemente en la estación de metro y fue bendecido por el sistema. Afortunadamente, alberga el sistema y viaja a otro mundo. En este mundo diferente lleno de cultivadores, Jiang Bei había pasado de ser una basura en un pequeño pueblo a un niño genio a los ojos de todos. Confiando en el sistema, Jiangbei había iniciado el camino de la mejora y se hizo más fuerte simplemente jugando tesoros y molestando a la gente. Después de una serie de batallas de caos y poesía, Jiang Bei gradualmente desarrolló sentimientos por sus familiares aquí","status":"En Emisión","year":2021,"genres":[],"type":"donghua","src":"donghualife","sourceUrls":["https://donghualife.com/series/i-annoyed-millions-cultivators"],"updatedAt":"2026-09-19T18:33:42.546Z"},"seasons":[{"id":"i-annoyed-millions-cultivators-t1","slug":"i-annoyed-millions-cultivators-t1","seriesId":"i-annoyed-millions-cultivators","number":1,"image":"https://donghualife.com/sites/default/files/styles/node_series/public/2024-12/anno%20bban.jpg?itok=il6a5fZ5","updatedAt":"2026-09-19T18:33:42.546Z","episodeCount":66},{"id":"i-annoyed-millions-cultivators-t2","slug":"i-annoyed-millions-cultivators-t2","seriesId":"i-annoyed-millions-cultivators","number":2,"image":"https://donghualife.com/sites/default/files/styles/node_series/public/2024-12/anno%20bban.jpg?itok=il6a5fZ5","updatedAt":"2026-09-19T18:33:42.546Z","episodeCount":14}],"episodes":[{"id":"i-annoyed-millions-cultivators-t1-e160","slug":"i-annoyed-millions-cultivators-t1-e160","title":"i-annoyed-millions-cultivators-1-x160","sourceUrl":"https://donghualife.com/episode/i-annoyed-millions-cultivators-1-x160","servers":[{"name":"ok.ru","url":"https://o