{"series":{"id":"dahua-zhi-shaonian-you","slug":"dahua-zhi-shaonian-you","title":"Dahua Zhi Shaonian You","image":"https://donghualife.com/sites/default/files/styles/node_series/public/2024-12/dh%20ban.jpg?itok=RYzWFAiT","synopsis":"El novato Jianghu y el espadachín Xiao Yao Sheng han derrotado al devorador de bebés que causó Chang'an, pero ahora se encuentran cayendo en un misterio mayor. Viajaron a la lejana Aldea de las Bestias Espirituales y se encontraron con la hermosa Demon Fox Girl, los Bone Elves y personas de todo tipo que habitan en Jianghu en el camino. Ganaron crecimiento y amistad, pero ahora están enredados en una crisis mayor: una disputa entre inmortales y demonios. ¡La animación combinará elementos como artes marciales, fantasía, sangre, aventuras y más, para presentarle a la audiencia una historia de altibajos en historias legendarias!","status":"En Emisión","year":2020,"genres":[],"type":"donghua","src":"donghualife","sourceUrls":["https://donghualife.com/series/dahua-zhi-shaonian-you"],"updatedAt":"2026-09-19T18:33:42.546Z"},"seasons":[{"id":"dahua-zhi-shaonian-you-t1","slug":"dahua-zhi-shaonian-you-t1","seriesId":"dahua-zhi-shaonian-you","number":1,"image":"https://donghualife.com/sites/default/files/styles/node_series/public/2024-12/dh%20ban.jpg?itok=RYzWFAiT","updatedAt":"2026-09-19T18:33:42.546Z","episodeCount":16}],"episodes":[{"id":"dahua-zhi-shaonian-you-t1-e16","slug":"dahua-zhi-shaonian-you-t1-e16","title":"dahua-zhi-shaonian-you-1-x16","sourceUrl":"https://donghualife.com/episode/dahua-zhi-shaonian-you-1-x16","servers":[{"name":"ok.ru","url":"https://ok.ru/videoembed/3333515578074","embed":true}],"seriesId":"dahua-zhi-shaonian-you","seasonId":"dahua-zhi-shaonian-you-t1","number":16,"updatedAt":"2026-09-19T18:44:24.882Z"},{"id":"dahua-zhi-shaonian-you-t1-e15","slug":"dahua-zhi-shaonian-you-t1-e15","title":"dahua-zhi-shaonian-you-1-x15","sourceUrl":"https://donghualife.com/episode/dahua-zhi-shaonian-you-1-x15","servers":[{"name":"ok.ru",