{"series":{"id":"gate-mystical-realm","slug":"gate-mystical-realm","title":"Gate Mystical Realm","image":"https://donghualife.com/sites/default/files/styles/node_series/public/2025-11/1000390169.jpg?itok=5DYseo37","synopsis":"En un mundo donde los guerreros son los soberanos, el destino de Shi Mu parecía estar destinado a ser diferente. Como hijo adoptivo de una familia noble, se ve obligado a emprender un camino de búsqueda de la verdad y de redención personal. Desde los duelos en los cuatro pabellones de Fengcheng hasta las disputas entre sectas, rodeado de intereses y enemigos poderosos, cada desafío lo hace más firme. Finalmente, Shi Mu despierta el poder de su linaje, cambiando no solo su propio destino, sino también el futuro de muchos otros.","status":"En Emisión","year":2025,"genres":[],"type":"donghua","src":"donghualife","sourceUrls":["https://donghualife.com/series/gate-mystical-realm"],"updatedAt":"2026-09-19T16:49:03.138Z"},"seasons":[{"id":"gate-mystical-realm-t1","slug":"gate-mystical-realm-t1","seriesId":"gate-mystical-realm","number":1,"image":"https://donghualife.com/sites/default/files/styles/node_series/public/2025-11/1000390169.jpg?itok=5DYseo37","updatedAt":"2026-09-19T16:49:03.138Z","episodeCount":26}],"episodes":[{"id":"gate-mystical-realm-t1-e26","slug":"gate-mystical-realm-t1-e26","title":"gate-mystical-realm-1-episodio-x26","sourceUrl":"https://donghualife.com/episode/gate-mystical-realm-1-episodio-x26","servers":[{"name":"rumble.com","url":"https://rumble.com/embed/v77aga6/?pub=4m2typ","embed":true},{"name":"geo.dailymotion.com","url":"https://geo.dailymotion.com/player.html?video=k4xa19nRTc4EaBFRFpa","embed":true}],"seriesId":"gate-mystical-realm","seasonId":"gate-mystical-realm-t1","number":26,"updatedAt":"2026-09-19T16:54:00.419Z"},{"id":"gate-mystical-realm-t1-e25","slug":"gate-mystical-realm-t1-e25","title":"gate-mystical-realm-1-episodio-x25","sourceUrl":"https://donghualife.com/episode/gate-mystical-realm-1-episodio-x25","servers":