{"series":{"id":"el-ascenso-del-dragon","slug":"el-ascenso-del-dragon","title":"El Ascenso Del Dragon","image":"https://donghualife.com/sites/default/files/styles/node_series/public/2025-02/v2-fc5e35d699762f328131cbf85d9f0c57_r.jpg?itok=wpJfa72F","synopsis":"Cuenta la leyenda que el Dios dragón está sentado en el reino de los Dioses, y si eres heredero de los Dioses, te convertirás en el nuevo gobernante del mundo. Las diversas sectas y pandillas están peleando gradualmente por la herencia del Dios dragón, el prota Chu Qianyue es tratado como el hijo de un pecador y negado el acceso, por lo que deberá subir a la terraza del dragón y ganarse su lugar mientras el fuego carcome su cuerpo y sus huesos se templan.","status":"En Emisión","year":2022,"genres":[],"type":"donghua","src":"donghualife","sourceUrls":["https://donghualife.com/series/el-ascenso-del-dragon"],"updatedAt":"2026-09-19T18:33:42.548Z"},"seasons":[{"id":"el-ascenso-del-dragon-t1","slug":"el-ascenso-del-dragon-t1","seriesId":"el-ascenso-del-dragon","number":1,"image":"https://donghualife.com/sites/default/files/styles/node_series/public/2025-02/v2-fc5e35d699762f328131cbf85d9f0c57_r.jpg?itok=wpJfa72F","updatedAt":"2026-09-19T18:33:42.548Z","episodeCount":40}],"episodes":[{"id":"el-ascenso-del-dragon-t1-e40","slug":"el-ascenso-del-dragon-t1-e40","title":"el-ascenso-del-dragon-1-episodio-x40","sourceUrl":"https://donghualife.com/episode/el-ascenso-del-dragon-1-episodio-x40","servers":[{"name":"ok.ru","url":"https://ok.ru/videoembed/3968973081306","embed":true}],"seriesId":"el-ascenso-del-dragon","seasonId":"el-ascenso-del-dragon-t1","number":40,"updatedAt":"2026-09-19T18:47:13.134Z"},{"id":"el-ascenso-del-dragon-t1-e39","slug":"el-ascenso-del-dragon-t1-e39","title":"el-ascenso-del-dragon-1-episodio-x39","sourceUrl":"https://donghualife.com/episode/el-ascenso-del-dragon-1-episodio-x39","servers":[{"name":"ok.ru","url":"https://ok.ru/videoembed/3968973015770","embed":true}],"seriesId":"el-ascenso-del-dragon",