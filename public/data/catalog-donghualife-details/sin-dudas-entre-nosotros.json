{"series":{"id":"sin-dudas-entre-nosotros","slug":"sin-dudas-entre-nosotros","title":"Sin dudas entre nosotros","image":"https://donghualife.com/images/webp/sin-dudas-entre-nosotros-2__coverImage.webp","synopsis":"Sinopsis.El general militar y reina que empuña cuchillos y lanzas, intercambiaron cuerpos e identidades debido a un accidente. El emperador que se convirtió en reina usó el poder imperial para gobernar el harén, y la relación con la madre era diferente a la del pasado. Los dos que tuvieron que aceptar la realidad, resolvieron sus malentendidos en el proceso de interactuar entre ellos y aprendieron el amor y la confianza. Formados como marido y mujer, no hay dudas sobre el amor y el cariño que se tienen.","genres":["Comedia","Romance","Drama"],"sourceUrl":"https://donghualife.com/series/sin-dudas-entre-nosotros","updatedAt":"2026-10-24T21:33:32.159Z"},"seasons":[{"id":"sin-dudas-entre-nosotros-1","slug":"sin-dudas-entre-nosotros-1","sourceUrl":"https://donghualife.com/watch/sin-dudas-entre-nosotros-1-1","image":null,"number":1,"seriesId":"sin-dudas-entre-nosotros","firstEpisodeUrl":"https://donghualife.com/watch/sin-dudas-entre-nosotros-1-1","updatedAt":"2026-10-24T21:34:14.829Z","episodeCount":24,"minEpisodeFound":1,"maxEpisodeFound":24,"missingEpisodes":[],"paginationComplete":true,"initialSyncComplete":true},{"id":"sin-dudas-entre-nosotros-2","slug":"sin-dudas-entre-nosotros-2","sourceUrl":"https://donghualife.com/watch/sin-dudas-entre-nosotros-2-1","image":null,"number":2,"seriesId":"sin-dudas-entre-nosotros","firstEpisodeUrl":"https://donghualife.com/watch/sin-dudas-entre-nosotros-2-1","updatedAt":"2026-10-24T21:33:57.511Z","episodeCount":24,"minEpisodeFound":1,"maxEpisodeFound":24,"missingEpisodes":[],"paginationComplete":true,"initialSyncComplete":true}],"episodes":[{"id":"sin-dudas-entre-nosotros-1-1","slug":"sin-dudas-entre-nosotros-1-1","title":"Sin dudas entre nosotros — Cap. 1","sourceUrl":"https://donghualife.com/watch/sin-dudas-entre-nosotros-