{"series":{"id":"sin-dudas-entre-nosotros","slug":"sin-dudas-entre-nosotros","title":"Sin Dudas Entre Nosotros","image":"https://donghualife.com/sites/default/files/styles/node_series/public/2025-03/a4366cebce.jpg?itok=XuVmBl5p","synopsis":"Sinopsis.El general militar y reina que empuña cuchillos y lanzas, intercambiaron cuerpos e identidades debido a un accidente. El emperador que se convirtió en reina usó el poder imperial para gobernar el harén, y la relación con la madre era diferente a la del pasado. Los dos que tuvieron que aceptar la realidad, resolvieron sus malentendidos en el proceso de interactuar entre ellos y aprendieron el amor y la confianza. Formados como marido y mujer, no hay dudas sobre el amor y el cariño que se tienen.","status":"En Emisión","year":2021,"genres":[],"type":"donghua","src":"donghualife","sourceUrls":["https://donghualife.com/series/sin-dudas-entre-nosotros"],"updatedAt":"2026-09-19T17:20:12.592Z"},"seasons":[{"id":"sin-dudas-entre-nosotros-t1","slug":"sin-dudas-entre-nosotros-t1","seriesId":"sin-dudas-entre-nosotros","number":1,"image":"https://donghualife.com/sites/default/files/styles/node_series/public/2025-03/a4366cebce.jpg?itok=XuVmBl5p","updatedAt":"2026-09-19T17:20:12.592Z","episodeCount":24},{"id":"sin-dudas-entre-nosotros-t2","slug":"sin-dudas-entre-nosotros-t2","seriesId":"sin-dudas-entre-nosotros","number":2,"image":"https://donghualife.com/sites/default/files/styles/node_series/public/2025-03/a4366cebce.jpg?itok=XuVmBl5p","updatedAt":"2026-09-19T17:20:12.592Z","episodeCount":24}],"episodes":[{"id":"sin-dudas-entre-nosotros-t1-e24","slug":"sin-dudas-entre-nosotros-t1-e24","title":"sin-dudas-entre-nosotros-1-episodio-x24","sourceUrl":"https://donghualife.com/episode/sin-dudas-entre-nosotros-1-episodio-x24","servers":[{"name":"ok.ru","url":"https://ok.ru/videoembed/4263375604442","embed":true}],"seriesId":"sin-dudas-entre-nosotros","seasonId":"sin-dudas-entre-nosotros-t1","number":24,"updatedAt":"2026-09-19T17:37:45.852Z"