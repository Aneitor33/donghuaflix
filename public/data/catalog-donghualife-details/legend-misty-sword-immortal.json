{"series":{"id":"legend-misty-sword-immortal","slug":"legend-misty-sword-immortal","title":"Legend Misty Sword Immortal","image":"https://donghualife.com/sites/default/files/styles/node_series/public/2025-08/1000318414.jpg?itok=9hMruYv_","synopsis":"Dongfang Xiaoyu, nacido con dos cuerpos espirituales pero incapaz de despertar su poder, es humillado y rechazado por su clan. Durante una crisis, logra activar su verdadera fuerza y salva a su familia. Aceptado por una secta poderosa, inicia un arduo camino de cultivo. Aunque es visto como una rareza, se enfrenta a constantes desafíos para volverse más fuerte, limpiar su nombre y desvelar la conspiración detrás de la alianza de inmortales.","status":"En Emisión","year":2025,"genres":[],"type":"donghua","src":"donghualife","sourceUrls":["https://donghualife.com/series/legend-misty-sword-immortal"],"updatedAt":"2026-09-19T17:20:12.576Z"},"seasons":[{"id":"legend-misty-sword-immortal-t1","slug":"legend-misty-sword-immortal-t1","seriesId":"legend-misty-sword-immortal","number":1,"image":"https://donghualife.com/sites/default/files/styles/node_series/public/2025-08/1000318414.jpg?itok=9hMruYv_","updatedAt":"2026-09-19T17:20:12.576Z","episodeCount":40}],"episodes":[{"id":"legend-misty-sword-immortal-t1-e38","slug":"legend-misty-sword-immortal-t1-e38","title":"legend-misty-sword-immortal-1-episodio-x38","sourceUrl":"https://donghualife.com/episode/legend-misty-sword-immortal-1-episodio-x38","servers":[{"name":"rumble.com","url":"https://rumble.com/embed/v70ojkm/?pub=35gq9p","embed":true},{"name":"geo.dailymotion.com","url":"https://geo.dailymotion.com/player.html?video=k6bxBcAezijLahEk1Yi","embed":true}],"seriesId":"legend-misty-sword-immortal","seasonId":"legend-misty-sword-immortal-t1","number":38,"updatedAt":"2026-09-19T17:25:55.064Z"},{"id":"legend-misty-sword-immortal-t1-e40","slug":"legend-misty-sword-immortal-t1-e40","title":"legend-misty-sword-immortal-1-episodio-x40","sourceUrl":"https://donghualife.com/episode/legend