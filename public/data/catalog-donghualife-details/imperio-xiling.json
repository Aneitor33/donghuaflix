{"series":{"id":"imperio-xiling","slug":"imperio-xiling","title":"Imperio Xiling","image":"https://donghualife.com/sites/default/files/styles/node_series/public/2025-04/390a4c6407.jpg?itok=x5J_9NX2","synopsis":"cuenta la historia de un otaku llamado Chen Jun que quiere comer y morir, y se convierte en el emperador de un imperio que se extiende por el multiverso sin ninguna preparación. Después de este encuentro fortuito, la vida original de Chen Jun se interrumpió. Originalmente quería ser una amante común, pero todo tipo de bellezas lo suplicaron y amenazaron, por lo que no tuvo más remedio que convertirse en emperador. Asumir la responsabilidad de salvar el mundo.","status":"En Emisión","year":2023,"genres":[],"type":"donghua","src":"donghualife","sourceUrls":["https://donghualife.com/series/imperio-xiling"],"updatedAt":"2026-09-19T18:33:42.556Z"},"seasons":[{"id":"imperio-xiling-t1","slug":"imperio-xiling-t1","seriesId":"imperio-xiling","number":1,"image":"https://donghualife.com/sites/default/files/styles/node_series/public/2025-04/390a4c6407.jpg?itok=x5J_9NX2","updatedAt":"2026-09-19T18:33:42.556Z","episodeCount":16}],"episodes":[{"id":"imperio-xiling-t1-e15","slug":"imperio-xiling-t1-e15","title":"imperio-xiling-1-episodio-x15","sourceUrl":"https://donghualife.com/episode/imperio-xiling-1-episodio-x15","servers":[{"name":"ok.ru","url":"https://ok.ru/videoembed/6269407005217","embed":true}],"seriesId":"imperio-xiling","seasonId":"imperio-xiling-t1","number":15,"updatedAt":"2026-09-19T18:53:18.272Z"},{"id":"imperio-xiling-t1-e16","slug":"imperio-xiling-t1-e16","title":"imperio-xiling-1-episodio-x16","sourceUrl":"https://donghualife.com/episode/imperio-xiling-1-episodio-x16","servers":[{"name":"ok.ru","url":"https://ok.ru/videoembed/6343511247393","embed":true}],"seriesId":"imperio-xiling","seasonId":"imperio-xiling-t1","number":16,"updatedAt":"2026-09-19T18:53:18.279Z"},{"id":"imperio-xiling-t1-e14","slug":"imperio-xiling-t1-e14","title":"imperio-xiling-1-episod