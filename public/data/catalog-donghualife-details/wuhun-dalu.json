{"series":{"id":"wuhun-dalu","slug":"wuhun-dalu","title":"Wuhun Dalu","image":"https://donghualife.com/sites/default/files/styles/node_series/public/2025-09/whdl%203_001_5882.png?itok=tSgRc3s2","synopsis":"Un científico moderno, Chu Feng, obtiene una llave hacia otro mundo y despierta en el Continente de los Espíritus Marciales. Allí, tras salvar a la hija de la familia Su, queda atrapado en la lucha entre clanes rivales. Obligado a dominar un arte marcial desconocido mientras enfrenta intrigas y emboscadas, Chu Feng usará su ingenio y el secreto de la Orden del Cuervo Dorado para abrirse camino en un mundo lleno de peligros.","status":"En Emisión","year":2025,"genres":[],"type":"donghua","src":"donghualife","sourceUrls":["https://donghualife.com/series/wuhun-dalu"],"updatedAt":"2026-09-19T18:33:42.542Z"},"seasons":[{"id":"wuhun-dalu-t1","slug":"wuhun-dalu-t1","seriesId":"wuhun-dalu","number":1,"image":"https://donghualife.com/sites/default/files/styles/node_series/public/2025-09/whdl%203_001_5882.png?itok=tSgRc3s2","updatedAt":"2026-09-19T18:33:42.542Z","episodeCount":48}],"episodes":[{"id":"wuhun-dalu-t1-e47","slug":"wuhun-dalu-t1-e47","title":"wuhun-dalu-1-episodio-x47","sourceUrl":"https://donghualife.com/episode/wuhun-dalu-1-episodio-x47","servers":[{"name":"rumble.com","url":"https://rumble.com/embed/v73m0b6/?pub=4m2typ","embed":true},{"name":"geo.dailymotion.com","url":"https://geo.dailymotion.com/player.html?video=k6nihK8DXwBmFEEVMoM","embed":true}],"seriesId":"wuhun-dalu","seasonId":"wuhun-dalu-t1","number":47,"updatedAt":"2026-09-19T18:39:15.461Z"},{"id":"wuhun-dalu-t1-e48","slug":"wuhun-dalu-t1-e48","title":"wuhun-dalu-1-episodio-x48","sourceUrl":"https://donghualife.com/episode/wuhun-dalu-1-episodio-x48","servers":[{"name":"rumble.com","url":"https://rumble.com/embed/v73pn2c/?pub=4m2typ","embed":true},{"name":"geo.dailymotion.com","url":"https://geo.dailymotion.com/player.html?video=k3QEXh0BrYguqDF4cvq","embed":true}],"seriesId":"wuhun-dalu","seasonId":"