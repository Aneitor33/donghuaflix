{"series":{"id":"eres-un-genio","slug":"eres-un-genio","title":"Eres Un Genio","image":"https://donghualife.com/sites/default/files/styles/node_series/public/2025-01/erg%20ban.jpg?itok=kcjFcWa6","synopsis":"Hay Continente Occidental y Continente Oriental en otro mundo. La parte norte del Continente Occidental está habitada por misteriosas tribus de las Montañas Nevadas, mientras que la parte sur está ocupada por el Gran Imperio Qin. La Magia es la fuente de energía en el mundo. Por el poder de la Magia, el Gran Imperio Qin derrotó a innumerables enemigos, superó desastres y estableció un próspero mundo civilizado. Ahora, un joven con un poder especial del norte comenzó una práctica contra la magia en el Continente Sur.","status":"En Emisión","year":2022,"genres":[],"type":"donghua","src":"donghualife","sourceUrls":["https://donghualife.com/series/eres-un-genio"],"updatedAt":"2026-09-19T18:33:42.546Z"},"seasons":[{"id":"eres-un-genio-t1","slug":"eres-un-genio-t1","seriesId":"eres-un-genio","number":1,"image":"https://donghualife.com/sites/default/files/styles/node_series/public/2025-01/erg%20ban.jpg?itok=kcjFcWa6","updatedAt":"2026-09-19T18:33:42.546Z","episodeCount":24}],"episodes":[{"id":"eres-un-genio-t1-e24","slug":"eres-un-genio-t1-e24","title":"eres-un-genio-1-x24","sourceUrl":"https://donghualife.com/episode/eres-un-genio-1-x24","servers":[{"name":"ok.ru","url":"https://ok.ru/videoembed/3528975190746","embed":true}],"seriesId":"eres-un-genio","seasonId":"eres-un-genio-t1","number":24,"updatedAt":"2026-09-19T18:44:15.643Z"},{"id":"eres-un-genio-t1-e23","slug":"eres-un-genio-t1-e23","title":"eres-un-genio-1-x23","sourceUrl":"https://donghualife.com/episode/eres-un-genio-1-x23","servers":[{"name":"ok.ru","url":"https://ok.ru/videoembed/3524485253850","embed":true}],"seriesId":"eres-un-genio","seasonId":"eres-un-genio-t1","number":23,"updatedAt":"2026-09-19T18:44:15.656Z"},{"id":"eres-un-genio-t1-e21","slug":"eres-un-genio-t1-e21","title":"eres-un-genio-1-x21","so