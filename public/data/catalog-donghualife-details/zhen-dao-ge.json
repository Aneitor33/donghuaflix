{"series":{"id":"zhen-dao-ge","slug":"zhen-dao-ge","title":"Zhen Dao Ge","image":"https://donghualife.com/sites/default/files/styles/poster/public/2025-03/14ce36d3d539b6003af3df84b41b222ac65c103819e6.png?itok=bFQ6kTPI","synopsis":"Zhen Dao Ge cuenta una historia de venganza sobre el joven sin hogar He Fangzhi, cuya familia fue traicionada por su propia gente mientras emigraban y fue brutalmente asesinada. El protagonista masculino, He Fangzhi, fingió estar muerto y escapó de una escena. Después de la masacre, practicó artes marciales extraordinarias en Shuzhong y decidió vengar a su familia. Con un abanico y un topónimo que mostraba las pistas del enemigo, emprendió el camino de la venganza.","status":"En Emisión","year":2025,"genres":[],"type":"donghua","src":"donghualife","sourceUrls":["https://donghualife.com/series/zhen-dao-ge"],"updatedAt":"2026-09-19T16:49:03.153Z"},"seasons":[{"id":"zhen-dao-ge-t1","slug":"zhen-dao-ge-t1","seriesId":"zhen-dao-ge","number":1,"image":"https://donghualife.com/sites/default/files/styles/poster/public/2025-03/14ce36d3d539b6003af3df84b41b222ac65c103819e6.png?itok=bFQ6kTPI","updatedAt":"2026-09-19T16:49:03.153Z","episodeCount":15},{"id":"zhen-dao-ge-t2","slug":"zhen-dao-ge-t2","seriesId":"zhen-dao-ge","number":2,"image":"https://donghualife.com/sites/default/files/styles/poster/public/2025-03/14ce36d3d539b6003af3df84b41b222ac65c103819e6.png?itok=bFQ6kTPI","updatedAt":"2026-09-19T16:49:03.153Z","episodeCount":14},{"id":"zhen-dao-ge-t3","slug":"zhen-dao-ge-t3","seriesId":"zhen-dao-ge","number":3,"image":"https://donghualife.com/sites/default/files/styles/poster/public/2025-03/14ce36d3d539b6003af3df84b41b222ac65c103819e6.png?itok=bFQ6kTPI","updatedAt":"2026-09-19T16:49:03.153Z","episodeCount":14}],"episodes":[{"id":"zhen-dao-ge-t1-e15","slug":"zhen-dao-ge-t1-e15","title":"zhen-dao-ge-1-episodio-x15","sourceUrl":"https://donghualife.com/episode/zhen-dao-ge-1-episodio-x15","servers":[{"name":"ok.ru","url":"https://ok.ru/videoembed/345772