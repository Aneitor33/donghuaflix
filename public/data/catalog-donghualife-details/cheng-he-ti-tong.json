{"series":{"id":"cheng-he-ti-tong","slug":"cheng-he-ti-tong","title":"Cheng He Ti Tong","image":"https://donghualife.com/sites/default/files/styles/node_series/public/2025-01/chht%20an.jpg?itok=D8f8oDYB","synopsis":"Yu Wanyin es teletransportado a una novela sobre luchas palaciegas. La protagonista femenina de la novela también es teletransportada a ella. Para invertir su destino de villana, Yu Wanyin decide unir fuerzas con un tirano, que también resulta ser un hombre moderno teletransportado. Yu Wanyin espera que los tres transmigrados dejen a un lado las luchas palaciegas y se dediquen a jugar a las cartas y a comer juntos pacíficamente. Sin embargo, la protagonista femenina cree que ella es la elegida, y sigue optando por ir en contra del equipo de Yu Wanyin y el protagonista masculino, el rey Duan. Así, Yu Wanyin tiene que llevar a cabo una serie de acciones para sobrevivir y ayudar a la dinastía Xia a prevenir la crisis de la sequía...","status":"En Emisión","year":2024,"genres":[],"type":"donghua","src":"donghualife","sourceUrls":["https://donghualife.com/series/cheng-he-ti-tong"],"updatedAt":"2026-09-19T18:33:42.546Z"},"seasons":[{"id":"cheng-he-ti-tong-t1","slug":"cheng-he-ti-tong-t1","seriesId":"cheng-he-ti-tong","number":1,"image":"https://donghualife.com/sites/default/files/styles/node_series/public/2025-01/chht%20an.jpg?itok=D8f8oDYB","updatedAt":"2026-09-19T18:33:42.546Z","episodeCount":24},{"id":"cheng-he-ti-tong-t2","slug":"cheng-he-ti-tong-t2","seriesId":"cheng-he-ti-tong","number":2,"image":"https://donghualife.com/sites/default/files/styles/node_series/public/2025-01/chht%20an.jpg?itok=D8f8oDYB","updatedAt":"2026-09-19T18:33:42.546Z","episodeCount":24}],"episodes":[{"id":"cheng-he-ti-tong-t1-e24","slug":"cheng-he-ti-tong-t1-e24","title":"cheng-he-ti-tong-1-x24","sourceUrl":"https://donghualife.com/episode/cheng-he-ti-tong-1-x24","servers":[{"name":"geo.dailymotion.com","url":"https://geo.dailymotion.com/player.html?video=k1p53LomBaFV2ECd3tw","embe