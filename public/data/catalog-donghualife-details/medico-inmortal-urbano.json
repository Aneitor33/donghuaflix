{"series":{"id":"medico-inmortal-urbano","slug":"medico-inmortal-urbano","title":"Medico Inmortal Urbano","image":"https://donghualife.com/sites/default/files/styles/node_series/public/2025-01/mius1an.jpg?itok=lCOjeh07","synopsis":"Ye Bufan, un estudiante de secundaria desesperado por recaudar fondos para los gastos médicos de su madre, ve su vida cambiar drásticamente cuando una joven lo atropella accidentalmente. Al borde de la muerte, Ye Bufan es transportado a una dimensión ilusoria donde hereda antiguos conocimientos de medicinaA partir de entonces, Ye Bufan adquiere conocimientos médicos avanzados, practica artes marciales y se convierte en un experto en ambas disciplinas. Su nueva habilidad no solo le permite ayudar a su madre, sino que también le gana el favor de innumerables mujeres hermosas.","status":"En Emisión","year":2024,"genres":[],"type":"donghua","src":"donghualife","sourceUrls":["https://donghualife.com/series/medico-inmortal-urbano"],"updatedAt":"2026-09-19T16:49:03.136Z"},"seasons":[{"id":"medico-inmortal-urbano-t1","slug":"medico-inmortal-urbano-t1","seriesId":"medico-inmortal-urbano","number":1,"image":"https://donghualife.com/sites/default/files/styles/node_series/public/2025-01/mius1an.jpg?itok=lCOjeh07","updatedAt":"2026-09-19T16:49:03.136Z","episodeCount":44}],"episodes":[{"id":"medico-inmortal-urbano-t1-e207","slug":"medico-inmortal-urbano-t1-e207","title":"medico-inmortal-urbano-1-episodio-x207","sourceUrl":"https://donghualife.com/episode/medico-inmortal-urbano-1-episodio-x207","servers":[{"name":"rumble.com","url":"https://rumble.com/embed/v7cigpy/?pub=4m2typ","embed":true}],"seriesId":"medico-inmortal-urbano","seasonId":"medico-inmortal-urbano-t1","number":207,"updatedAt":"2026-09-19T16:50:32.003Z"},{"id":"medico-inmortal-urbano-t1-e206","slug":"medico-inmortal-urbano-t1-e206","title":"medico-inmortal-urbano-1-episodio-x206","sourceUrl":"https://donghualife.com/episode/medico-inmortal-urbano-1-episodio-x206","servers":[{"name":"rumble