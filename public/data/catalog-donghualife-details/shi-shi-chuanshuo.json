{"series":{"id":"shi-shi-chuanshuo","slug":"shi-shi-chuanshuo","title":"Shi Shi Chuanshuo","image":"https://donghualife.com/images/webp/shi-shi-chuanshuo-1__coverImage.webp","synopsis":"Sinopsis. Ye Chong era un habitante de Trash Planet-12. Un fatídico día, descubrió entre un montón de basura un tesoro que alteraría para siempre su destino: Mu Shang, una máquina desconocida con inteligencia artificial y memoria perdida. Juntos, se aventuran en la vasta galaxia mientras el aislado \"hombre de las cavernas\" que era Ye Chong comenzó a absorber todo tipo de conocimientos y a conocer gente de todos los ámbitos de la vida. Poco a poco descubre más y más sobre su propio pasado misterioso y el de su pareja.","genres":["Acción"],"sourceUrl":"https://donghualife.com/series/shi-shi-chuanshuo","updatedAt":"2026-10-24T21:37:23.632Z"},"seasons":[{"id":"shi-shi-chuanshuo-1","slug":"shi-shi-chuanshuo-1","sourceUrl":"https://donghualife.com/watch/shi-shi-chuanshuo-1-1","image":null,"number":1,"seriesId":"shi-shi-chuanshuo","firstEpisodeUrl":"https://donghualife.com/watch/shi-shi-chuanshuo-1-1","updatedAt":"2026-10-24T21:37:41.795Z","episodeCount":26,"minEpisodeFound":1,"maxEpisodeFound":26,"missingEpisodes":[],"paginationComplete":true,"initialSyncComplete":true}],"episodes":[{"id":"shi-shi-chuanshuo-1-1","slug":"shi-shi-chuanshuo-1-1","title":"Shi Shi Chuanshuo — Cap. 1","sourceUrl":"https://donghualife.com/watch/shi-shi-chuanshuo-1-1","servers":[],"previousUrl":null,"nextUrl":"https://donghualife.com/watch/shi-shi-chuanshuo-1-2","updatedAt":"2026-10-24T21:37:24.394Z","seriesId":"shi-shi-chuanshuo","seasonId":"shi-shi-chuanshuo-1","number":1,"releaseDate":null},{"id":"shi-shi-chuanshuo-1-2","slug":"shi-shi-chuanshuo-1-2","title":"Shi Shi Chuanshuo — Cap. 2","sourceUrl":"https://donghualife.com/watch/shi-shi-chuanshuo-1-2","servers":[],"previousUrl":"https://donghualife.com/watch/shi-shi-chuanshuo-1-1","nextUrl":"https://donghualife.com/watch/shi-shi-chuanshuo-1-3","updatedAt":"20