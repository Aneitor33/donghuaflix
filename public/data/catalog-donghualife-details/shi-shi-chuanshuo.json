{"series":{"id":"shi-shi-chuanshuo","slug":"shi-shi-chuanshuo","title":"Shi Shi Chuanshuo","image":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx137706-AxfdF6cqSs5k.png","synopsis":"Sinopsis. Ye Chong era un habitante de Trash Planet-12. Un fatídico día, descubrió entre un montón de basura un tesoro que alteraría para siempre su destino: Mu Shang, una máquina desconocida con inteligencia artificial y memoria perdida. Juntos, se aventuran en la vasta galaxia mientras el aislado \"hombre de las cavernas\" que era Ye Chong comenzó a absorber todo tipo de conocimientos y a conocer gente de todos los ámbitos de la vida. Poco a poco descubre más y más sobre su propio pasado misterioso y el de su pareja.","status":"En Emisión","year":2023,"genres":[],"type":"donghua","src":"donghualife","sourceUrls":["https://donghualife.com/series/shi-shi-chuanshuo"],"updatedAt":"2026-09-19T18:33:42.545Z"},"seasons":[{"id":"shi-shi-chuanshuo-t1","slug":"shi-shi-chuanshuo-t1","seriesId":"shi-shi-chuanshuo","number":1,"image":"https://donghualife.com/sites/default/files/styles/node_series/public/2025-05/imuyu.jpg?itok=iIN_oTli","updatedAt":"2026-09-19T18:33:42.545Z","episodeCount":26}],"episodes":[{"id":"shi-shi-chuanshuo-t1-e26","slug":"shi-shi-chuanshuo-t1-e26","title":"shi-shi-chuanshuo-1-episodio-x26","sourceUrl":"https://donghualife.com/episode/shi-shi-chuanshuo-1-episodio-x26","servers":[{"name":"dailymotion.com","url":"https://www.dailymotion.com/embed/video/kuo7hXsYF28N2QA1z6M","embed":true},{"name":"rumble.com","url":"https://rumble.com/embed/v4bmyii/?pub=35gq9p","embed":true}],"seriesId":"shi-shi-chuanshuo","seasonId":"shi-shi-chuanshuo-t1","number":26,"updatedAt":"2026-09-19T18:42:28.977Z"},{"id":"shi-shi-chuanshuo-t1-e25","slug":"shi-shi-chuanshuo-t1-e25","title":"shi-shi-chuanshuo-1-episodio-x25","sourceUrl":"https://donghualife.com/episode/shi-shi-chuanshuo-1-episodio-x25","servers":[{"name":"dailymotion.com","url":"https://www.dailymotion.com/embed/video/k4