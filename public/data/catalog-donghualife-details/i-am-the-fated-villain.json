{"series":{"id":"i-am-the-fated-villain","slug":"i-am-the-fated-villain","title":"I Am The Fated Villain","image":"https://donghualife.com/uploads/images/1785178789221_1000582972.jpg","synopsis":"Gu Changge transmigra a un mundo de fantasía y descubre que se ha convertido en el gran villano destinado a ser derrotado por el Hijo del Destino. Para sobrevivir y cambiar su destino, se ve obligado a aprovechar un sistema y su conocimiento previo de los clichés de este tipo de historias. Así, comienza a planear, arrebatar las oportunidades y reprimir a cada uno de los Hijos del Destino, obteniendo recompensas que lo llevan a ascender paso a paso hasta la cima.","genres":["Cultivo","Acción","Fantasía"],"sourceUrl":"https://donghualife.com/series/i-am-the-fated-villain","updatedAt":"2026-10-24T21:36:17.519Z"},"seasons":[{"id":"60b54e48-b0e9-4736-8aa5-366a9ad752b5-temporada-1","slug":"60b54e48-b0e9-4736-8aa5-366a9ad752b5-temporada-1","sourceUrl":"https://donghualife.com/watch/60b54e48-b0e9-4736-8aa5-366a9ad752b5-temporada-1-1","image":null,"number":1,"seriesId":"i-am-the-fated-villain","firstEpisodeUrl":"https://donghualife.com/watch/60b54e48-b0e9-4736-8aa5-366a9ad752b5-temporada-1-1","updatedAt":"2026-10-24T21:36:34.642Z","episodeCount":31,"minEpisodeFound":1,"maxEpisodeFound":31,"missingEpisodes":[],"paginationComplete":true,"initialSyncComplete":true}],"episodes":[{"id":"60b54e48-b0e9-4736-8aa5-366a9ad752b5-temporada-1-1","slug":"60b54e48-b0e9-4736-8aa5-366a9ad752b5-temporada-1-1","title":"I Am The Fated Villain — Cap. 1","sourceUrl":"https://donghualife.com/watch/60b54e48-b0e9-4736-8aa5-366a9ad752b5-temporada-1-1","servers":[],"previousUrl":null,"nextUrl":"https://donghualife.com/watch/60b54e48-b0e9-4736-8aa5-366a9ad752b5-temporada-1-2","updatedAt":"2026-10-24T21:36:17.951Z","seriesId":"i-am-the-fated-villain","seasonId":"60b54e48-b0e9-4736-8aa5-366a9ad752b5-temporada-1","number":1,"releaseDate":null},{"id":"60b54e48-b0e9-4736-8aa5-366a9ad752b5-temporada-1-2","slug":"60b