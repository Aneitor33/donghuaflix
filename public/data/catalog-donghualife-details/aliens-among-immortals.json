{"series":{"id":"aliens-among-immortals","slug":"aliens-among-immortals","title":"Aliens Among Immortals","image":"https://donghualife.com/images/webp/aliens-among-immortals-1__coverImage.webp","synopsis":"Jiang Yuan y Zhao Riyue son obligados a casarse por un acuerdo de intereses entre sectas. En la noche de bodas intentan matarse, solo para descubrir que ambos poseen cuerpos inmortales. Para obtener los tesoros secretos del otro, pasan de enemigos mortales a esposos solo en apariencia, engañándose mutuamente, sin saber que comparten el mismo pasado: sus hogares fueron destruidos por el Vacio. Unidos por el destino, se ven obligados a aliarse, no solo para recuperar tesoros perdidos, sino también para enfrentarse a todo el mundo de la cultivación, plagado de peligros. En medio de crisis constantes, buscan la esperanza de derrotar al Vacio.Estudio: Suoyi Technology (索以科技)","genres":["Acción","Cultivo","Artes marciales"],"sourceUrl":"https://donghualife.com/series/aliens-among-immortals","updatedAt":"2026-10-24T21:31:51.432Z"},"seasons":[{"id":"aliens-among-immortals-1","slug":"aliens-among-immortals-1","sourceUrl":"https://donghualife.com/watch/aliens-among-immortals-1-1","image":null,"number":1,"seriesId":"aliens-among-immortals","firstEpisodeUrl":"https://donghualife.com/watch/aliens-among-immortals-1-1","updatedAt":"2026-10-24T21:32:30.360Z","episodeCount":60,"minEpisodeFound":1,"maxEpisodeFound":60,"missingEpisodes":[],"paginationComplete":true,"initialSyncComplete":true}],"episodes":[{"id":"aliens-among-immortals-1-1","slug":"aliens-among-immortals-1-1","title":"Aliens Among Immortals — Cap. 1","sourceUrl":"https://donghualife.com/watch/aliens-among-immortals-1-1","servers":[],"previousUrl":null,"nextUrl":"https://donghualife.com/watch/aliens-among-immortals-1-2","updatedAt":"2026-10-24T21:31:51.871Z","seriesId":"aliens-among-immortals","seasonId":"aliens-among-immortals-1","number":1,"releaseDate":null},{"id":"aliens-among-immortals-1-2","slug":"aliens-among-i