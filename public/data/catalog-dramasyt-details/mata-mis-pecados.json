{"series": {"id": "mata-mis-pecados", "slug": "mata-mis-pecados", "title": "Mata mis pecados", "image": "https://image.tmdb.org/t/p/w780/deOKq1S08lF02FdLiiUxwJpgQiQ.jpg", "status": "En Emisión", "type": "drama", "synopsis": "La historia de Mata mis pecados sigue a Ye Ping'an, una médica del alma que llega a la Ciudad Sagrada para investigar un antiguo caso. Entre rumores de que manipula la mente, la gente la rehuye y la tilda de \"bruja\". Cuando un asesinato sacude la ciudad, Ye Ping'an es acusada como principal sospechosa. Yuan Shaocheng, un ambicioso funcionario que aspira a escalar en la corte, percibe algo extraño pero aun así la condena. Lo que ignora es que Ye Ping'an ya ha dado el primer paso en su camino de venganza.", "year": "2025", "updatedAt": "2026-09-26T06:57:22.155784+00:00", "sourceUrl": "https://www.youtube.com/playlist?list=PLGj4pO6ilVzZa4nTgAnOFTv7QKG0wuZ_c", "channel": "YOUKU Spanish"}, "seasons": [{"id": "mata-mis-pecados-s1", "seriesId": "mata-mis-pecados", "number": 1, "title": "Temporada 1"}], "episodes": [{"id": "mata-mis-pecados-ep-1", "slug": "mata-mis-pecados-ep-1", "seriesId": "mata-mis-pecados", "seasonId": "mata-mis-pecados-s1", "number": 1, "title": "Episodio 1", "servers": [{"name": "YouTube", "url": "https://www.youtube.com/embed/Rk5qkPrrn5U"}], "updatedAt": "2026-09-26T06:57:22.155784+00:00"}, {"id": "mata-mis-pecados-ep-2", "slug": "mata-mis-pecados-ep-2", "seriesId": "mata-mis-pecados", "seasonId": "mata-mis-pecados-s1", "number": 2, "title": "Episodio 2", "servers": [{"name": "YouTube", "url": "https://www.youtube.com/embed/9vBJjfe4L0E"}], "updatedAt": "2026-09-26T06:57:22.155784+00:00"}, {"id": "mata-mis-pecados-ep-3", "slug": "mata-mis-pecados-ep-3", "seriesId": "mata-mis-pecados", "seasonId": "mata-mis-pecados-s1", "number": 3, "title": "Episodio 3", "servers": [{"name": "YouTube", "url": "https://www.youtube.com/embed/MNEE-TXJuj0"}], "updatedAt": "2026-09-26T06:57:22.155784+00:00"}, {"id": "mata-mis-pecados-ep-4", "slug": "