{"series": {"id": "esposa-del-general", "slug": "esposa-del-general", "title": "Esposa del General", "image": "https://image.tmdb.org/t/p/w780/sqUQ6KKPIRXnO4CiY7WbH33ultd.jpg", "status": "En Emisión", "type": "drama", "synopsis": "La joven Su Hua se fugó con el general Xiao Yun por amor, pero fue traicionada por su hermana mayor y violada y enterrada viva por el segundo joven amo, Xiao Ye. Su Hua renace como la cortesana Qing Yan, firma un contrato matrimonial con Xiao Yun y entra en la Residencia Xiao para comenzar su venganza. En el camino, supera innumerables obstáculos, rescata a otras mujeres perseguidas, castiga a la familia Xiao y finalmente recupera su verdadera identidad para reunirse con Xiao Yun.", "year": "2025", "updatedAt": "2026-09-26T06:56:39.087272+00:00", "sourceUrl": "https://www.youtube.com/playlist?list=PLFz85Hafaajs", "channel": "YOUKU Spanish"}, "seasons": [{"id": "esposa-del-general-s1", "seriesId": "esposa-del-general", "number": 1, "title": "Temporada 1"}], "episodes": [{"id": "esposa-del-general-ep-1", "slug": "esposa-del-general-ep-1", "seriesId": "esposa-del-general", "seasonId": "esposa-del-general-s1", "number": 1, "title": "Episodio 1", "servers": [{"name": "YouTube", "url": "https://www.youtube.com/embed/9PruQZulrAA"}], "updatedAt": "2026-09-26T06:56:39.087272+00:00"}, {"id": "esposa-del-general-ep-3", "slug": "esposa-del-general-ep-3", "seriesId": "esposa-del-general", "seasonId": "esposa-del-general-s1", "number": 3, "title": "Episodio 3", "servers": [{"name": "YouTube", "url": "https://www.youtube.com/embed/-L_oKj_9sTE"}], "updatedAt": "2026-09-26T06:56:39.087272+00:00"}, {"id": "esposa-del-general-ep-5", "slug": "esposa-del-general-ep-5", "seriesId": "esposa-del-general", "seasonId": "esposa-del-general-s1", "number": 5, "title": "Episodio 5", "servers": [{"name": "YouTube", "url": "https://www.youtube.com/embed/RtwvYx02aDk"}], "updatedAt": "2026-09-26T06:56:39.087272+00:00"}, {"id": "esposa-del-general-ep-7", "slug": "esposa-del