{"series": {"id": "ofrenda-al-demonio", "slug": "ofrenda-al-demonio", "title": "Ofrenda al Demonio", "image": "https://image.tmdb.org/t/p/w780/xZqSHe74UMIvV8Cjzx0fcvo7i1D.jpg", "status": "En Emisión", "type": "drama", "synopsis": "Un oficinista moderno, Zou Yan, tropieza por accidente con el mundo de la cultivación y despierta convertido en Liao Tingyan, discípula de la secta Qinggutian. Pronto es elegida para servir al Gran Maestro Sima Jiao, un poderoso cultivador que ha estado sellado en secreto dentro de una montaña durante 500 años. Retorcido por el aislamiento y la ira, él es frío, temperamental y está obsesionado con la venganza. Liao Tingyan ignora que su identidad original era la de una asesina demoníaca. Pero, para sorpresa de él, ella no muestra malicia, ni ambición, ni deseo alguno. Su naturaleza lo intriga.", "updatedAt": "2026-09-26T05:01:22.784526+00:00", "sourceUrl": "", "channel": "YOUKU Spanish"}, "seasons": [{"id": "ofrenda-al-demonio-s1", "seriesId": "ofrenda-al-demonio", "number": 1, "title": "Temporada 1"}], "episodes": [{"id": "ofrenda-al-demonio-ep-1", "slug": "ofrenda-al-demonio-ep-1", "seriesId": "ofrenda-al-demonio", "seasonId": "ofrenda-al-demonio-s1", "number": 1, "title": "Episodio 1", "servers": [{"name": "YouTube", "url": "https://www.youtube.com/embed/Tr_Vy2iq72c"}], "updatedAt": "2026-09-26T05:01:22.784526+00:00"}, {"id": "ofrenda-al-demonio-ep-2", "slug": "ofrenda-al-demonio-ep-2", "seriesId": "ofrenda-al-demonio", "seasonId": "ofrenda-al-demonio-s1", "number": 2, "title": "Episodio 2", "servers": [{"name": "YouTube", "url": "https://www.youtube.com/embed/w8V_op1FjVE"}], "updatedAt": "2026-09-26T05:01:22.784526+00:00"}, {"id": "ofrenda-al-demonio-ep-3", "slug": "ofrenda-al-demonio-ep-3", "seriesId": "ofrenda-al-demonio", "seasonId": "ofrenda-al-demonio-s1", "number": 3, "title": "Episodio 3", "servers": [{"name": "YouTube", "url": "https://www.youtube.com/embed/rfsjHb5114Q"}], "updatedAt": "2026-09-26T05:01:22.784526+00:00"}, {"id"