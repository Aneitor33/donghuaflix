{"series": {"id": "b-king", "slug": "b-king", "title": "B King", "image": "./public/img/posters-donghuacli/b-king.jpg", "status": "En Emisión", "type": "donghua", "synopsis": "This is the tale of a well-known cartoonist who rose to fame thanks to his comic book.B.K. But after several years, he ran out of ideas and had to rely solely on abandoning his characters in order to draw attention. He was drawn into the realm of B. King as Wang Xiaoming after receiving an enigmatic phone call one day. As a result, Wang Xiaoming, who now possesses the ideas of the “creator,” sets out on a fantastical journey that might be summed up as “God’s shortcut, one step to heaven.”", "updatedAt": "2026-09-25T22:26:42.389038+00:00", "sourceUrl": ""}, "seasons": [{"id": "b-king-s1", "seriesId": "b-king", "number": 1, "title": "Temporada 1"}], "episodes": [{"id": "b-king-ep-1", "slug": "b-king-ep-1", "seriesId": "b-king", "seasonId": "b-king-s1", "number": 1, "title": "Episodio 1", "servers": [], "pages": {"lm": "https://lmanime.com/b-king-episode-01/"}, "updatedAt": "2026-09-25T22:26:42.389038+00:00"}, {"id": "b-king-ep-2", "slug": "b-king-ep-2", "seriesId": "b-king", "seasonId": "b-king-s1", "number": 2, "title": "Episodio 2", "servers": [], "pages": {"lm": "https://lmanime.com/b-king-episode-02/"}, "updatedAt": "2026-09-25T22:26:42.389038+00:00"}, {"id": "b-king-ep-3", "slug": "b-king-ep-3", "seriesId": "b-king", "seasonId": "b-king-s1", "number": 3, "title": "Episodio 3", "servers": [], "pages": {"lm": "https://lmanime.com/b-king-episode-03/"}, "updatedAt": "2026-09-25T22:26:42.389038+00:00"}, {"id": "b-king-ep-4", "slug": "b-king-ep-4", "seriesId": "b-king", "seasonId": "b-king-s1", "number": 4, "title": "Episodio 4", "servers": [], "pages": {"lm": "https://lmanime.com/b-king-episode-04/"}, "updatedAt": "2026-09-25T22:26:42.389038+00:00"}, {"id": "b-king-ep-5", "slug": "b-king-ep-5", "seriesId": "b-king", "seasonId": "b-king-s1", "number": 5, "title": "Episodio 5", "servers": [], "pag