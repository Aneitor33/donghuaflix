a.","status":"Released","country":null,"genres":["Comedia"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1315843","type":"flyflix","contentType":"movie","year":2026,"updatedAt":"2026-10-22T12:13:08.487Z"},{"id":"movie-1423577","slug":"movie-1423577","title":"Gremlins 3","image":"https://image.tmdb.org/t/p/w300/i23drDYlMobxkRLRstynrfVkPqL.jpg","synopsis":null,"status":"In Production","country":null,"genres":["Comedia","Terror","Fantasía"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1423577","type":"flyflix","contentType":"movie","year":2028,"updatedAt":"2026-10-22T12:13:08.786Z"},{"id":"movie-49521","slug":"movie-49521","title":"El hombre de acero","image":"https://image.tmdb.org/t/p/w300/5JW44QGgpEWx4aWXM0uVSi2xtrI.jpg","synopsis":"Un niño descubre que posee poderes extraordinarios y que no pertenece a este planeta. En su juventud, viaja para descubrir sus orígenes y las razones por las cuales ha sido enviado a la Tierra. Pero el héroe que lleva dentro tiene que emerger para que pueda salvar al mundo de la aniquilación y convertirse en el símbolo de esperanza para la humanidad.","status":"Released","country":null,"genres":["Acción","Aventura","Ciencia ficción"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/49521","type":"flyflix","contentType":"movie","year":2013,"updatedAt":"2026-10-22T12:13:09.088Z"},{"id":"movie-1798383","slug":"movie-1798383","title":"Wolves Up Close with Bertie Gregory","image":null,"synopsis":null,"status":"Post Production","country":null,"genres":["Documental"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1798383","type":"flyflix","contentType":"movie","year":2026,"updatedAt":"2026-10-22T12:13:09.419Z"},{"id":"movie-1797731","slug":"movie-1797731","title":"خواب نما","image":"https://image.tmdb.org/t/p/w300/1XbXUfyhOfaXPhTNOVAj0hUbY7J.jpg","synopsis":null,"status":"Released","country":null,"genres":["Comedia","Familia"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/17977