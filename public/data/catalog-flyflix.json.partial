ada, dos jóvenes empleados, acompañados por un veterano agente de bioterrorismo, deben sobrevivir al turno de noche más alocado de la historia para salvar a la humanidad de la extinción, mientras el microorganismo se propaga y destruye todo a su paso.","status":"Released","country":null,"genres":["Terror","Ciencia ficción","Comedia"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/696393","type":"flyflix","contentType":"movie","year":2026,"updatedAt":"2026-10-22T12:05:06.197Z"},{"id":"movie-1589713","slug":"movie-1589713","title":"Badut Gendong","image":"https://image.tmdb.org/t/p/w300/kIAltyOVZFIRFFFgBUBABb0HyF7.jpg","synopsis":null,"status":"Released","country":null,"genres":["Acción","Drama","Terror","Fantasía","Suspense"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1589713","type":"flyflix","contentType":"movie","year":2026,"updatedAt":"2026-10-22T12:05:06.500Z"},{"id":"movie-1788682","slug":"movie-1788682","title":"Sumukhi Suresh: Hoemonal","image":"https://image.tmdb.org/t/p/w300/3zmfnrpjZDz9sSglPzpPDLa21KS.jpg","synopsis":null,"status":"Released","country":null,"genres":["Comedia"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1788682","type":"flyflix","contentType":"movie","year":2026,"updatedAt":"2026-10-22T12:05:06.801Z"},{"id":"movie-1544847","slug":"movie-1544847","title":"പ്രഥമ ദൃഷ്ട്യാ കുറ്റക്കാർ","image":"https://image.tmdb.org/t/p/w300/zrvnu0M5NkO7aniAhfLYi3xGK7E.jpg","synopsis":null,"status":"Released","country":null,"genres":["Crimen","Drama","Suspense"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1544847","type":"flyflix","contentType":"movie","year":2026,"updatedAt":"2026-10-22T12:05:07.101Z"},{"id":"movie-1417935","slug":"movie-1417935","title":"Filipiñana","image":"https://image.tmdb.org/t/p/w300/pe0MudvC8VOoTtAMCTIfHqrRo8o.jpg","synopsis":null,"status":"Released","country":null,"genres":["Drama","Misterio"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1417935","type":"fly