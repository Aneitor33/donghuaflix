d cada vez más alejado de ella, Julia debe luchar para salvar al hombre al que ama y detener a un mal insaciable que convierte el deseo en adicción y exige sangre para sobrevivir...","status":"Released","country":null,"genres":["Terror"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1314826","type":"flyflix","contentType":"movie","year":2026,"updatedAt":"2026-10-18T11:29:51.180Z"},{"id":"movie-1741109","slug":"movie-1741109","title":"WWE SummerSlam 2026: Saturday","image":"https://image.tmdb.org/t/p/w300/adzFKQwbd0Cy6YIOxPwMIbiY2Hh.jpg","synopsis":null,"status":"Released","country":null,"genres":["Acción","Drama"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1741109","type":"flyflix","contentType":"movie","year":2026,"updatedAt":"2026-10-18T11:29:51.525Z"},{"id":"movie-1559632","slug":"movie-1559632","title":"Bride of Frankenstein Awakens","image":"https://image.tmdb.org/t/p/w300/3OhXjilaXq0Sae6Poi6ctJojvOL.jpg","synopsis":null,"status":"Released","country":null,"genres":["Terror"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1559632","type":"flyflix","contentType":"movie","year":2026,"updatedAt":"2026-10-18T11:29:51.890Z"},{"id":"movie-1360829","slug":"movie-1360829","title":"ヴァージン・パンク Clockwork Girl","image":"https://image.tmdb.org/t/p/w300/oARmiq6Lar4RNAlPzsuRf8cqL8j.jpg","synopsis":"Ubu, una mujer marcada por la desgracia, se convierte en una sombra de sí misma. Rodeada de personajes intensos, enfrenta un conflicto cargado de tensión emocional y psicológica.","status":"Released","country":null,"genres":["Animación","Acción","Ciencia ficción"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1360829","type":"flyflix","contentType":"movie","year":2025,"updatedAt":"2026-10-18T11:29:52.233Z"},{"id":"movie-1554364","slug":"movie-1554364","title":"Full Phil","image":"https://image.tmdb.org/t/p/w300/yHiCY08iWt15PiEaQX1lBSwm1Ze.jpg","synopsis":null,"status":"Released","country":null,"genres":["Comedia","Drama"],"tot