le":"Everest: The Other Side","image":"https://image.tmdb.org/t/p/w300/2m9ts8LfjG8d4xcUtx66aApngJL.jpg","synopsis":"Un retrato íntimo de dos personas unidas por el amor, la ambición y la búsqueda de lo imposible. Los esquiadores de montaña de élite Jim Morrison e Hilaree Nelson se enamoraron profundamente mientras alcanzaban la cima de su disciplina. Su determinación se transformó en un sueño compartido: escalar y descender esquiando la cara norte directa del Monte Everest —la ruta de ascenso más difícil y peligrosa de la montaña y la línea de esquí más codiciada del planeta—, una hazaña que solo unos pocos han logrado completar y que nadie ha conseguido descender esquiando con éxito.","status":"Released","country":null,"genres":["Documental"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1603262","type":"flyflix","contentType":"movie","year":2026,"updatedAt":"2026-10-17T11:02:54.633Z"},{"id":"movie-1758886","slug":"movie-1758886","title":"Papa où t'es ?","image":"https://image.tmdb.org/t/p/w300/3HqZ26kFQnyJKVgtzu8MnrzKBLX.jpg","synopsis":null,"status":"Released","country":null,"genres":["Documental"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1758886","type":"flyflix","contentType":"movie","year":2026,"updatedAt":"2026-10-17T11:02:54.926Z"},{"id":"movie-806704","slug":"movie-806704","title":"The Batman: Part II","image":"https://image.tmdb.org/t/p/w300/r5fl4aMsmTjgc8DdDqQaM84roWp.jpg","synopsis":"Secuela de la película de 2022 'The Batman'.","status":"In Production","country":null,"genres":["Misterio","Drama","Crimen"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/806704","type":"flyflix","contentType":"movie","year":2028,"updatedAt":"2026-10-17T11:02:55.218Z"},{"id":"movie-1283025","slug":"movie-1283025","title":"鬼畜父の性玩具","image":"https://image.tmdb.org/t/p/w300/spmtKfoFOv1PXyMT5F7IbUdQ94D.jpg","synopsis":null,"status":"Released","country":null,"genres":[],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1283