],"totalEpisodes":1235,"sourceUrl":"https://flyflix.net/watch/60572-tv","type":"flyflix","contentType":"series","year":1997,"updatedAt":"2026-10-22T12:21:28.592Z"},{"id":"tv-110316","slug":"tv-110316","title":"Alice in Borderland","image":"https://image.tmdb.org/t/p/w300/xcOnCOpwe86Deau7P1VQNe0X6cg.jpg","synopsis":"Un aficionado a los videojuegos y sus dos amigos se ven atrapados en una versión paralela de Tokio, donde deben competir en sádicos juegos para sobrevivir.","status":"Finalizado","country":null,"genres":["Misterio","Drama","Action & Adventure"],"totalEpisodes":22,"sourceUrl":"https://flyflix.net/watch/110316-tv","type":"flyflix","contentType":"series","year":2020,"updatedAt":"2026-10-22T12:21:28.904Z"},{"id":"tv-130853","slug":"tv-130853","title":"Mono malo","image":"https://image.tmdb.org/t/p/w300/1O9U18Qk11DQ57GBEQw79JC2kTh.jpg","synopsis":"Un detective convertido en inspector de restaurantes en el sur de Florida se ve arrastrado a un mundo de codicia y corrupción cuando un turista encuentra un brazo amputado mientras pescaba. Y sí, hay un mono.","status":"En emisión","country":null,"genres":["Comedia","Crimen"],"totalEpisodes":20,"sourceUrl":"https://flyflix.net/watch/130853-tv","type":"flyflix","contentType":"series","year":2024,"updatedAt":"2026-10-22T12:21:29.226Z"},{"id":"tv-65701","slug":"tv-65701","title":"Good Mythical Morning","image":"https://image.tmdb.org/t/p/w300/jMpBQr2aNOFAI6wsC47zsOG6qOh.jpg","synopsis":null,"status":"En emisión","country":null,"genres":["Comedia"],"totalEpisodes":3485,"sourceUrl":"https://flyflix.net/watch/65701-tv","type":"flyflix","contentType":"series","year":2012,"updatedAt":"2026-10-22T12:21:29.628Z"},{"id":"tv-240576","slug":"tv-240576","title":"Magilumiere Magical Girls S. A.","image":"https://image.tmdb.org/t/p/w300/aRzHdjkmThEynuQiknrgZUYp0WX.jpg","synopsis":"Chicas mágicas: fuertes, molonas, el trabajo más soñado. Kana Sakuragi está buscando trabajo, pero ¡no hay manera! Un día, es víctima del ataque de un Kaii. Hitomi Koshigaya, una chica mágica de lo más alocada, acude al rescate y Kana se vale de su prodigiosa memoria para ayudarla a derrotarlo. ¡Kana acaba contratada en Magical Girls S.A. Magilumiere y da su primer paso en el mundo laboral!","status":"Finalizado","country":null,"genres":["Animación","Action & Adventure","Sci-Fi & Fantasy","Comedia"],"totalEpisodes":24,"sourceUrl":"https://flyflix.net/watch/240576-tv","type":"flyflix","contentType":"series","year":2024,"updatedAt":"2026-10-22T12:21:29.933Z"},{"id":"tv-335052","slug":"tv-335052","title":"โคตรรัก","image":"https://image.tmdb.org/t/p/w300/8voRdRs8vTdluMb372F6gKyyCR6.jpg","synopsis":null,"status":"En emisión","country":null,"genres":["Drama"],"totalEpisodes":8,"sourceUrl":"https://flyflix.net/watch/335052-tv","type":"flyflix","contentType":"series","year":2026,"updatedAt":"2026-10-22T12:21:30.238Z"},{"id":"tv-296437","slug":"tv-296437","title":"The Frontier Lord Begins with Zero Subjects","image":"https://image.tmdb.org/t/p/w300/iEKBOFKstkKNuJ2sK2vhz8Gvu2T.jpg","synopsis":"Tras pasar décadas en la guerra, Dias regresa a casa convertido en héroe y recibe un territorio como recompensa, pero no es más que una inmensa llanura desierta. Sin saber cómo salir adelante fuera del campo de batalla, tendrá que empezar de cero. Por suerte, Alna, una chica con cuernos, está a punto de demostrarle que esas tierras esconden mucho más de lo que aparentan.","status":"Finalizado","country":null,"genres":["Comedia","Animación","Action & Adventure","Sci-Fi & Fantasy"],"totalEpisodes":12,"sourceUrl":"https://flyflix.net/watch/296437-tv","type":"flyflix","contentType":"series","year":2026,"updatedAt":"2026-10-22T12:21:30.541Z"},{"id":"tv-1711","slug":"tv-1711","title":"Strictly Come Dancing","image":"https://image.tmdb.org/t/p/w300/b9Ki18BAlZqtU28THIgUkSfnq8T.jpg","synopsis":null,"status":"En emisión","country":null,"genres":["Reality"],"totalEpisodes":609,"sourceUrl":"https://flyflix.net/watch/1711-tv","type":"flyflix","contentType":"series","year":2004,"updatedAt":"2026-10-22T12:21:30.845Z"},{"id":"tv-12786","slug":"tv-12786","title":"Los misterios de Murdoch","image":"https://image.tmdb.org/t/p/w300/1mAo1Mt2c7p3AJ4U0MyKhks62KO.jpg","synopsis":"En la década de 1890, el inspector de policía William Murdoch utiliza técnicas forenses radicales para la época, incluidas las pruebas de huellas dactilares y de detección, y con este enfoque más científico puede resolver los casos de homicidio más resonantes de la ciudad.","status":"En emisión","country":null,"genres":["Misterio","Drama"],"totalEpisodes":334,"sourceUrl":"https://flyflix.net/watch/12786-tv","type":"flyflix","contentType":"series","year":2008,"updatedAt":"2026-10-22T12:21:31.149Z"},{"id":"tv-300480","slug":"tv-300480","title":"Gatos callejeros, de Ricky Gervais","image":"https://image.tmdb.org/t/p/w300/2cN9viibPOov0hZKMi0KLVVlFpm.jpg","synopsis":"En esta insolente comedia de animación de Ricky Gervais, unos gatos callejeros siembran el caos y urden una travesura disparatada detrás de otra.","status":"En emisión","country":null,"genres":["Animación","Comedia"],"totalEpisodes":6,"sourceUrl":"https://flyflix.net/watch/300480-tv","type":"flyflix","contentType":"series","year":2026,"updatedAt":"2026-10-22T12:21:31.454Z"},{"id":"tv-90937","slug":"tv-90937","title":"Beastars","image":"https://image.tmdb.org/t/p/w300/jjsLEOThEri8jES4eQq9Nwvrvsr.jpg","synopsis":"En un mundo donde conviven bestias de todo tipo, los instintos carnívoros de un amable lobo despiertan mientras su instituto debe lidiar con un asesinato.","status":"Finalizado","country":null,"genres":["Animación","Drama","Misterio","Crimen"],"totalEpisodes":48,"sourceUrl":"https://flyflix.net/watch/90937-tv","type":"flyflix","contentType":"series","year":2019,"updatedAt":"2026-10-22T12:21:31.758Z"},{"id":"tv-119769","slug":"tv-119769","title":"Taxi Driver","image":"https://image.tmdb.org/t/p/w300/vOi7qlPjmF9D5mnqroEQPCL6sVD.jpg","synopsis":"La serie se centra en \"Rainbow Taxi Company\", un misterioso servicio de taxis donde sus miembros se vengan en nombre de las víctimas que no pueden obtener justicia por parte de la ley.","status":"Finalizado","country":null,"genres":["Action & Adventure","Crimen","Drama"],"totalEpisodes":48,"sourceUrl":"https://flyflix.net/watch/119769-tv","type":"flyflix","contentType":"series","year":2021,"updatedAt":"2026-10-22T12:21:32.065Z"},{"id":"tv-72071","slug":"tv-72071","title":"The Chi","image":"https://image.tmdb.org/t/p/w300/niD8X5pEXpmRUDhSPdDOgI3Gw5Q.jpg","synopsis":"Una historia relevante, oportuna y distintiva de la mayoría de edad de un joven afroestadounidense en la que el simple hecho de crecer puede ser una cuestión de vida o muerte.","status":"Finalizado","country":null,"genres":["Drama"],"totalEpisodes":88,"sourceUrl":"https://flyflix.net/watch/72071-tv","type":"flyflix","contentType":"series","year":2018,"updatedAt":"2026-10-22T12:21:32.370Z"},{"id":"tv-287496","slug":"tv-287496","title":"Camino al Esplendor","image":"https://image.tmdb.org/t/p/w300/erj7cX8aa1jndO9HlmoyRcJNLQL.jpg","synopsis":"Zhao Ling, un contrabandista de sal de origen humilde pero de carácter generoso y grandes aspiraciones, conoce a Fu Tingyun, una joven de una familia noble que ha sido falsamente acusada de mantener una relación ilícita. Obligados a huir juntos, la pareja deberá enfrentar severas pruebas por parte de sus familias y de la corte imperial. En su lucha contra el destino, finalmente consolidarán una unión legendaria.","status":"Finalizado","country":null,"genres":["Drama"],"totalEpisodes":36,"sourceUrl":"https://flyflix.net/watch/287496-tv","type":"flyflix","contentType":"series","year":2026,"updatedAt":"2026-10-22T12:21:32.791Z"},{"id":"tv-337726","slug":"tv-337726","title":"سرخ و سیاه","image":"https://image.tmdb.org/t/p/w300/4U88BSI0jrY4yKYqy3BPHa4pqqP.jpg","synopsis":null,"status":"En emisión","country":null,"genres":["Drama"],"totalEpisodes":6,"sourceUrl":"https://flyflix.net/watch/337726-tv","type":"flyf