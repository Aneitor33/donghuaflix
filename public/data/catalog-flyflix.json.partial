s":null,"status":"En emisión","country":null,"genres":["Drama"],"totalEpisodes":24,"sourceUrl":"https://flyflix.net/watch/283012-tv","type":"flyflix","contentType":"series","year":2026,"updatedAt":"2026-10-18T11:37:54.588Z"},{"id":"tv-139512","slug":"tv-139512","title":"Otome Game Sekai wa Mob ni Kibishii Sekai desu","image":"https://image.tmdb.org/t/p/w300/9fJYueAX0XTqFIPokQxFAoapGvr.jpg","synopsis":"Leon era un oficinista que es reencarnado en un videojuego de citas, donde las mujeres gobiernan y sólo los hombres atractivos tienen éxito. Pero Leon guarda un secreto: Él recuerda todo de su vida pasada, incluyendo la totalidad del juego en el que ahora está atrapadao. Leon luchará contra el orden establecido para lograr su último deseo... Tener una vida pacífica en el campo.","status":"Finalizado","country":null,"genres":["Animación","Comedia","Sci-Fi & Fantasy"],"totalEpisodes":24,"sourceUrl":"https://flyflix.net/watch/139512-tv","type":"flyflix","contentType":"series","year":2022,"updatedAt":"2026-10-18T11:37:54.937Z"},{"id":"tv-224263","slug":"tv-224263","title":"Stranger Things: Relatos del 85","image":"https://image.tmdb.org/t/p/w300/ssls8OpHHXtHcvIy7AiXipBddQX.jpg","synopsis":"Hawkins. Invierno de 1985. En un pueblo lleno de secretos, unos héroes se enfrentan a nuevos misterios... y a una nueva y extraña amenaza.","status":"En emisión","country":null,"genres":["Animación","Sci-Fi & Fantasy","Misterio","Action & Adventure"],"totalEpisodes":18,"sourceUrl":"https://flyflix.net/watch/224263-tv","type":"flyflix","contentType":"series","year":2026,"updatedAt":"2026-10-18T11:37:55.292Z"},{"id":"tv-256694","slug":"tv-256694","title":"Hora de aventuras: Misiones legendarias","image":"https://image.tmdb.org/t/p/w300/q33LoVGyZopnwnNTzaPliKw8SOA.jpg","synopsis":"Finn y Jake recorren el Mundo de Ooo viviendo aventuras, ayudando a la Gente Nube y enfrentándose a las fuerzas del mal.","status":"En emisión","country":null,"genres":["Animación","Action & Adventure","Sci-Fi & F