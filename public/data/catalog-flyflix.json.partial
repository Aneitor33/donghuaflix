!».","status":"Released","country":null,"genres":["Animación","Comedia","Familia"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1297842","type":"flyflix","contentType":"movie","year":2026,"updatedAt":"2026-10-13T04:18:19.229Z"},{"id":"movie-1145899","slug":"movie-1145899","title":"Marsupilami","image":"https://image.tmdb.org/t/p/w300/kMhVs1XqmzXlD0mDQ4rTJh4Kvf1.jpg","synopsis":"David debe entregar un paquete desde Sudamérica y descubre que transporta un bebé Marsupilami.","status":"Released","country":null,"genres":["Aventura","Comedia","Familia"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1145899","type":"flyflix","contentType":"movie","year":2026,"updatedAt":"2026-10-13T04:18:19.575Z"},{"id":"movie-1649424","slug":"movie-1649424","title":"70 Up","image":"https://image.tmdb.org/t/p/w300/fssXQF0BvwvAa8VXKVqRwPTmdVw.jpg","synopsis":null,"status":"Released","country":null,"genres":["Documental"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1649424","type":"flyflix","contentType":"movie","year":2026,"updatedAt":"2026-10-13T04:18:19.924Z"},{"id":"movie-1596260","slug":"movie-1596260","title":"Night Nurse","image":"https://image.tmdb.org/t/p/w300/cvj1d5avMYRxK8FVpq07UqLrcbZ.jpg","synopsis":null,"status":"Released","country":null,"genres":["Drama","Suspense"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1596260","type":"flyflix","contentType":"movie","year":2026,"updatedAt":"2026-10-13T04:18:20.269Z"},{"id":"movie-1590933","slug":"movie-1590933","title":"汝、星のごとく","image":"https://image.tmdb.org/t/p/w300/nRoVOvMPOEM9GuHu5FKGigbXzVT.jpg","synopsis":null,"status":"Released","country":null,"genres":["Drama","Romance"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1590933","type":"flyflix","contentType":"movie","year":2026,"updatedAt":"2026-10-13T04:18:20.619Z"},{"id":"movie-1650814","slug":"movie-1650814","title":"Dos días","image":"https://image.tmdb.org/t/p/w300/9Gv1GySYPi3VC0jXFn3OnlQnrGg.jpg","syn