los atentados a los periodistas que dieron sus primeros pasos profesionales cubriendo la guerra contra el terrorismo, pasando por los jóvenes afganos y marines que sufrieron las consecuencias de la caótica retirada de EE. UU. de Afganistán: sus estremecedores testimonios muestran que el legado del 11-S no se mide solo por su trascendencia histórica, sino por las vidas que aún sigue marcando.","status":"Released","country":null,"genres":["Documental"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1752159","type":"flyflix","contentType":"movie","year":2026,"updatedAt":"2026-10-22T12:08:14.231Z"},{"id":"movie-1195506","slug":"movie-1195506","title":"Novocaine","image":"https://image.tmdb.org/t/p/w300/6YbTJhN5GJQOlZ1IyRiCyhKSiJE.jpg","synopsis":"Cuando la chica de sus sueños es secuestrada, Nate, un chico corriente, convierte su incapacidad para sentir dolor en una fuerza inesperada en su lucha por recuperarla.","status":"Released","country":null,"genres":["Acción","Comedia","Suspense"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1195506","type":"flyflix","contentType":"movie","year":2025,"updatedAt":"2026-10-22T12:08:14.534Z"},{"id":"movie-1457169","slug":"movie-1457169","title":"What We Dreamed Of Then","image":"https://image.tmdb.org/t/p/w300/3qvGPigMqPGnqXtiAKZmBgWslMI.jpg","synopsis":null,"status":"Released","country":null,"genres":["Drama"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1457169","type":"flyflix","contentType":"movie","year":2026,"updatedAt":"2026-10-22T12:08:14.835Z"},{"id":"movie-1613021","slug":"movie-1613021","title":"Camembert","image":"https://image.tmdb.org/t/p/w300/jJECyLZIHUZxQbC1VowuURFs2Kl.jpg","synopsis":null,"status":"Released","country":null,"genres":["Comedia"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1613021","type":"flyflix","contentType":"movie","year":2026,"updatedAt":"2026-10-22T12:08:15.150Z"},{"id":"movie-1242015","slug":"movie-1242015","title":"Recién nacidas","ima