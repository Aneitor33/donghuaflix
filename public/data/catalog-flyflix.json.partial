opsis":"Varios reinos legendarios se han fusionado de forma repentina... e inestable. Un maestro de Spinjitzu debe entrenar a una nueva generación de héroes ninja capaces de encontrar a los Dragones Elementales: son los que pueden salvar el planeta antes de que las fuerzas del mal accedan a esa energía dracónica para aniquilar el nuevo mundo.","status":"En emisión","country":null,"genres":["Animación","Action & Adventure","Kids"],"totalEpisodes":80,"sourceUrl":"https://flyflix.net/watch/212989-tv","type":"flyflix","contentType":"series","year":2023,"updatedAt":"2026-10-18T11:37:38.401Z"},{"id":"tv-239384","slug":"tv-239384","title":"สัมผัสกันต์ธีร์","image":"https://image.tmdb.org/t/p/w300/pqAofEGxSjt9x51kvruw2dpXYJD.jpg","synopsis":null,"status":"En emisión","country":null,"genres":["Drama"],"totalEpisodes":10,"sourceUrl":"https://flyflix.net/watch/239384-tv","type":"flyflix","contentType":"series","year":2026,"updatedAt":"2026-10-18T11:37:38.745Z"},{"id":"tv-283319","slug":"tv-283319","title":"Marble Hall Murders","image":"https://image.tmdb.org/t/p/w300/3WfgRJBIaOTsiu2bQO23xWb08ro.jpg","synopsis":null,"status":"En emisión","country":null,"genres":["Misterio","Crimen"],"totalEpisodes":6,"sourceUrl":"https://flyflix.net/watch/283319-tv","type":"flyflix","contentType":"series","year":2026,"updatedAt":"2026-10-18T11:37:39.144Z"},{"id":"tv-309328","slug":"tv-309328","title":"Yeraltı","image":"https://image.tmdb.org/t/p/w300/bu8ks983hBPEzyAH8gSATW5aPJ7.jpg","synopsis":null,"status":"En emisión","country":null,"genres":["Drama","Action & Adventure"],"totalEpisodes":19,"sourceUrl":"https://flyflix.net/watch/309328-tv","type":"flyflix","contentType":"series","year":2026,"updatedAt":"2026-10-18T11:37:39.629Z"},{"id":"tv-331693","slug":"tv-331693","title":"Sevdam Karadeniz","image":"https://image.tmdb.org/t/p/w300/zOqcJuBcEgzwKax9jHQM4MGAy0y.jpg","synopsis":null,"status":"En emisión","country":null,"genres":["Drama"],"totalEpisodes":3,"sourceUrl":"https://flyflix.net/watch/