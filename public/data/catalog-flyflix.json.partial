 un viaje que no se parece en nada a lo que se ha enfrentado hasta ahora: una búsqueda de la paz interior. Pero el retiro de Thor se ve interrumpido por un asesino galáctico conocido como Gorr el Carnicero de Dioses. Para hacer frente a la amenaza, Thor solicita la ayuda de Valkiria, de Korg y de su ex novia Jane Foster que, para sorpresa de Thor, empuña su martillo mágico, Mjolnir, como la Poderosa Thor. Juntos, se embarcan en una aventura cósmica en la que tendrán que descubrir el misterio de la venganza del Carnicero de Dioses y detenerlo antes de que sea demasiado tarde.","status":"Released","country":null,"genres":["Fantasía","Acción","Comedia"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/616037","type":"flyflix","contentType":"movie","year":2022,"updatedAt":"2026-10-14T12:16:59.508Z"},{"id":"movie-1754100","slug":"movie-1754100","title":"灵魂摆渡·蝴蝶梦","image":"https://image.tmdb.org/t/p/w300/42Tjyix5gue0iBURvNzY4vT7l8a.jpg","synopsis":null,"status":"Released","country":null,"genres":["Drama","Aventura","Fantasía"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1754100","type":"flyflix","contentType":"movie","year":2026,"updatedAt":"2026-10-14T12:16:59.784Z"}],"seasons":[{"id":"movie-1148365-1","slug":"movie-1148365-1","seriesId":"movie-1148365","sourceUrl":"https://flyflix.net/watch/1148365","number":1,"image":"https://image.tmdb.org/t/p/w300/ev2GnYar3LUyui8sOu4gqeMXvLi.jpg","episodeCount":1,"initialSyncComplete":true,"updatedAt":"2026-10-14T12:07:29.641Z"},{"id":"movie-1400837-1","slug":"movie-1400837-1","seriesId":"movie-1400837","sourceUrl":"https://flyflix.net/watch/1400837","number":1,"image":"https://image.tmdb.org/t/p/w300/vsde9OnhjFMlJz8Wi6Z6drZ7GG5.jpg","episodeCount":1,"initialSyncComplete":true,"updatedAt":"2026-10-14T12:07:29.917Z"},{"id":"movie-950028-1","slug":"movie-950028-1","seriesId":"movie-950028","sourceUrl":"https://flyflix.net/watch/950028","number":1,"image":"https://image.tmdb.org/t/p/w300/21JnfyCARiRkms9AZHtTXi