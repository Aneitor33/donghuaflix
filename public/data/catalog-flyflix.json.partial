eUrl":"https://flyflix.net/watch/1440304","type":"flyflix","contentType":"movie","year":2026,"updatedAt":"2026-10-13T13:59:58.972Z"},{"id":"movie-840873","slug":"movie-840873","title":"A Magnificent Life - La extraordinaria vida de Marcel Pagnol","image":"https://image.tmdb.org/t/p/w300/fvwHnifQwk9gk0beWrhhCtJz4q1.jpg","synopsis":"Entre los años 30 y 50, un joven curioso de Marsella transformó su amor por la palabra en un legado eterno. Marcel Pagnol: dramaturgo, novelista y cineasta visionario que marcó para siempre la historia del cine francés. Desde sus raíces de clase media hasta convertirse en una de las figuras más innovadoras y prolíficas de su tiempo, la película explora su genio creativo, su audacia artística y su profunda humanidad.","status":"Released","country":null,"genres":["Animación","Historia","Drama"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/840873","type":"flyflix","contentType":"movie","year":2025,"updatedAt":"2026-10-13T13:59:59.266Z"},{"id":"movie-1261763","slug":"movie-1261763","title":"డోంట్ ట్రబుల్ ద ట్రబుల్","image":"https://image.tmdb.org/t/p/w300/A0uqqpeLhGfOsW6muky7xvLd8Qf.jpg","synopsis":null,"status":"Released","country":null,"genres":["Fantasía","Drama","Acción"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1261763","type":"flyflix","contentType":"movie","year":2026,"updatedAt":"2026-10-13T13:59:59.576Z"},{"id":"movie-1780005","slug":"movie-1780005","title":"Contra El Huracán","image":"https://image.tmdb.org/t/p/w300/lFaMt4I8LiQAGW9Rb5gfGFXbvOY.jpg","synopsis":null,"status":"Post Production","country":null,"genres":["Drama"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1780005","type":"flyflix","contentType":"movie","year":2026,"updatedAt":"2026-10-13T13:59:59.889Z"},{"id":"movie-1583853","slug":"movie-1583853","title":"Se domani non torno","image":"https://image.tmdb.org/t/p/w300/cBzYad8BrcrlprHa17O4UDnACC1.jpg","synopsis":null,"status":"In Production","country":null,"genres":["Drama"]