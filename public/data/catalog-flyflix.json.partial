movie-9426","title":"La mosca","image":"https://image.tmdb.org/t/p/w300/lotsO2VRhsmeFKzqncMX9xrYMj6.jpg","synopsis":"Seth Brundle, un excéntrico y solitario científico que crea uno de los inventos más revolucionarios de la historia: la cabina de teletransportación. En un intento por ponerla a prueba a la vez que ignora todo atisbo de prudencia, decide usarse a sí mismo como cobaya en la primera teletransportación aplicada a un humano, con la mala suerte de que una mosca se introduce junto con él en el artefacto. A partir de allí comenzará para Brundle una gradual pero definitiva transformación, una inquietante metamorfosis que le consumirá poco a poco, poniéndole en peligro a él y a los que le rodean.","status":"Released","country":null,"genres":["Terror","Ciencia ficción"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/9426","type":"flyflix","contentType":"movie","year":1986,"updatedAt":"2026-10-13T04:24:58.178Z"},{"id":"movie-1636891","slug":"movie-1636891","title":"Mexicali","image":"https://image.tmdb.org/t/p/w300/kQbmqipH7YvmILnB0PF8faOEcUp.jpg","synopsis":null,"status":"Released","country":null,"genres":["Acción","Drama"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1636891","type":"flyflix","contentType":"movie","year":2026,"updatedAt":"2026-10-13T04:24:58.530Z"},{"id":"movie-1522126","slug":"movie-1522126","title":"1000 Men and Me: The Bonnie Blue Story","image":"https://image.tmdb.org/t/p/w300/5dcgoyf8nt6Xt4VSR6Nrn6nwhuz.jpg","synopsis":null,"status":"Released","country":null,"genres":["Documental","Película de TV"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1522126","type":"flyflix","contentType":"movie","year":2025,"updatedAt":"2026-10-13T04:24:58.878Z"},{"id":"movie-1193824","slug":"movie-1193824","title":"Rabbit Trap","image":"https://image.tmdb.org/t/p/w300/sKnwnnmBpjo9BEskHtja6ToXUV1.jpg","synopsis":null,"status":"Released","country":null,"genres":["Suspense","Fantasía","Terror","Misterio","Drama"],"totalEp