pisodes":null,"sourceUrl":"https://flyflix.net/watch/1412113","type":"flyflix","contentType":"movie","year":2025,"updatedAt":"2026-10-13T04:34:55.934Z"},{"id":"movie-81","slug":"movie-81","title":"Guerreros del viento","image":"https://image.tmdb.org/t/p/w300/z7vvu0n1F8pXQtmE113Gwd5KhRN.jpg","synopsis":"En un futuro lejano, en un mundo post-apocalíptico, la Tierra está cubierta por unos bosques llenos de hongos venenosos e insectos gigantescos. Los humanos han quedado reducidos a unos pocos pueblos aislados que intentan sobrevivir a la plaga mientras luchan entre ellos. En medio de todo esto la princesa Nausicaä, del Valle del Viento, quien ama a los insectos, buscará comprender el origen del problema y conseguir la paz entre los hombres, y sobre todo entre éstos y el bosque.","status":"Released","country":null,"genres":["Aventura","Animación","Fantasía"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/81","type":"flyflix","contentType":"movie","year":1984,"updatedAt":"2026-10-13T04:34:56.281Z"},{"id":"movie-1461701","slug":"movie-1461701","title":"FOUFO","image":"https://image.tmdb.org/t/p/w300/3J1fBDGQVIofbQ1aS1F60Ag1Vg2.jpg","synopsis":null,"status":"Released","country":null,"genres":["Animación","Aventura","Comedia","Drama","Ciencia ficción"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1461701","type":"flyflix","contentType":"movie","year":2026,"updatedAt":"2026-10-13T04:34:56.630Z"},{"id":"movie-1398725","slug":"movie-1398725","title":"Swallowed Star: Continente Sangriento","image":"https://image.tmdb.org/t/p/w300/IGd3wIImV94X9MwM9yLebYoUc0.jpg","synopsis":null,"status":"Released","country":null,"genres":["Animación","Acción","Ciencia ficción","Aventura"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1398725","type":"flyflix","contentType":"movie","year":2024,"updatedAt":"2026-10-13T04:34:56.976Z"},{"id":"movie-1619484","slug":"movie-1619484","title":"Eine Krankheit wie ein Gedicht","image":"https://image.tmdb.org/t/p/w