spense"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/37724","type":"flyflix","contentType":"movie","year":2012,"updatedAt":"2026-10-18T11:28:31.606Z"},{"id":"movie-141","slug":"movie-141","title":"Donnie Darko","image":"https://image.tmdb.org/t/p/w300/1YjDHBC4v2O7IQDKYAiM8fOxzf3.jpg","synopsis":"Donnie es un chico americano dotado de gran inteligencia e imaginación. Tras escapar milagrosamente de una muerte casi segura, comienza a sufrir alucinaciones que lo llevan a actuar como nunca hubiera imaginado y a descubrir un mundo insólito a su alrededor, pues en sus visiones un gran conejito lo manipula para cometer una serie de crímenes.","status":"Released","country":null,"genres":["Fantasía","Drama","Misterio"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/141","type":"flyflix","contentType":"movie","year":2001,"updatedAt":"2026-10-18T11:28:31.962Z"},{"id":"movie-1590723","slug":"movie-1590723","title":"Laut Bercerita","image":"https://image.tmdb.org/t/p/w300/8FqJSSMPaKJzqq2VVxVmdHUozLY.jpg","synopsis":null,"status":"Released","country":null,"genres":["Drama","Historia"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1590723","type":"flyflix","contentType":"movie","year":2026,"updatedAt":"2026-10-18T11:28:32.318Z"},{"id":"movie-1545621","slug":"movie-1545621","title":"Detective Conan 29: El ángel caído de la carretera","image":"https://image.tmdb.org/t/p/w300/5pEcrCTuocLsHeLKCE4zRgmmkOK.jpg","synopsis":"Edogawa Conan y Chihaya Hagiwara deben unirse para identificar al conductor de la misteriosa motocicleta completamente negra que causó el caos en Kanagawa.","status":"Released","country":null,"genres":["Acción","Animación","Misterio","Crimen"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1545621","type":"flyflix","contentType":"movie","year":2026,"updatedAt":"2026-10-18T11:28:32.660Z"},{"id":"movie-1181107","slug":"movie-1181107","title":"El Rey de Reyes","image":"https://image.tmdb.org/t/p/w300/oukn96XolAQBXykW