er.","status":"Released","country":null,"genres":["Drama","Música"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1230368","type":"flyflix","contentType":"movie","year":2025,"updatedAt":"2026-10-20T11:52:43.045Z"},{"id":"movie-1439112","slug":"movie-1439112","title":"Ajuste de cuentas: La ciudad de los lobos","image":"https://image.tmdb.org/t/p/w300/yBg2t8vuqrE8nqrxS3VzW3Qvzh3.jpg","synopsis":"Jake Rosser está atormentado por el trastorno de estrés postraumático de sus días como oficial K-9 y se esfuerza por llevar una vida pacífica con su familia y su compañero K-9 retirado, Socks. Pero la tranquilidad se disuelve rápidamente cuando una despiadada banda los persigue en un brutal ataque. Decidido a proteger a sus seres queridos, Jake y su nuevo compañero K-9 «Argos» se adentran en los violentos entresijos de la delincuencia, donde Jake se enfrenta a funcionarios corruptos, descubre una peligrosa red de tráfico de drogas y lucha contra sus propios demonios internos.","status":"Released","country":null,"genres":["Acción","Suspense","Misterio"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1439112","type":"flyflix","contentType":"movie","year":2025,"updatedAt":"2026-10-20T11:52:43.344Z"},{"id":"movie-1732479","slug":"movie-1732479","title":"14th","image":"https://image.tmdb.org/t/p/w300/r40Ez6NORhNfjzcnsbpb1xDycuF.jpg","synopsis":null,"status":"Released","country":null,"genres":["Documental","Historia"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1732479","type":"flyflix","contentType":"movie","year":2026,"updatedAt":"2026-10-20T11:52:43.650Z"},{"id":"movie-1721251","slug":"movie-1721251","title":"Bapak Paling Jujur","image":"https://image.tmdb.org/t/p/w300/dO4XM18B792WojquLq3oF98eZM5.jpg","synopsis":null,"status":"Released","country":null,"genres":["Comedia","Drama"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1721251","type":"flyflix","contentType":"movie","year":2026,"updatedAt":"2026-10-20T11:52:43.957Z"},