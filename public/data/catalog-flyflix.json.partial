flix.net/watch/1432474","type":"flyflix","contentType":"movie","year":2026,"updatedAt":"2026-10-13T04:15:01.820Z"},{"id":"movie-1437195","slug":"movie-1437195","title":"En vivo desde el infierno","image":"https://image.tmdb.org/t/p/w300/1UYm1w6shyYyqFGsry2JMaq56K2.jpg","synopsis":"Cuando Kevin Hart colabora con los streamers Kai Cenat y Druski en una transmisión en vivo que rompe récords de audiencia desde su mansión hipertecnológica, todo es muy divertido hasta que las bromas se transforman en pánico y deben resolver un asesinato real en cámara. El trío y sus invitados famosos quedan atrapados en una comedia de horror mientras millones los miran.","status":"Released","country":null,"genres":["Terror","Comedia"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1437195","type":"flyflix","contentType":"movie","year":2026,"updatedAt":"2026-10-13T04:15:02.176Z"},{"id":"movie-1671548","slug":"movie-1671548","title":"给阿嬷的情书","image":"https://image.tmdb.org/t/p/w300/s0sC3hPPX4OobLNfdl2iSs2vtvI.jpg","synopsis":null,"status":"Released","country":null,"genres":["Drama","Familia","Comedia"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1671548","type":"flyflix","contentType":"movie","year":2026,"updatedAt":"2026-10-13T04:15:02.529Z"},{"id":"movie-1074074","slug":"movie-1074074","title":"El ser querido","image":"https://image.tmdb.org/t/p/w300/LdKLipXCdKHNXxUxn8l7UTdnXJ.jpg","synopsis":"Un aclamado director de cine y su hija, una actriz sin éxito, ruedan juntos una película tras años de distanciamiento y un pasado difícil del que ninguno de los dos ha querido hablar.","status":"Released","country":null,"genres":["Drama"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1074074","type":"flyflix","contentType":"movie","year":2026,"updatedAt":"2026-10-13T04:15:02.902Z"},{"id":"movie-1084242","slug":"movie-1084242","title":"Zootrópolis 2","image":"https://image.tmdb.org/t/p/w300/4fRdfQPjHiuDSkzaxFAV44k7Iem.jpg","synopsis":"Después de resolver el 