ountry":null,"genres":[],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1762510","type":"flyflix","contentType":"movie","year":null,"updatedAt":"2026-10-13T04:36:04.625Z"},{"id":"movie-9871","slug":"movie-9871","title":"Ginger Snaps","image":"https://image.tmdb.org/t/p/w300/ozohDiJd7Oi65NEf8B0ya7lR9Fr.jpg","synopsis":"Brigitte y su hermana Ginger son dos adolescentes muy unidas... y aburridas de su rutinaria vida. Pero cierta noche en que deciden gastar una broma a un chico, Ginger acaba siendo atacada por una extraña criatura. Aunque se recupera milagrosamente de las heridas, Ginger no está bien: comienzan a crecerle pelos en las cicatrices, una cola asoma por la base de su espina dorsal y siente un deseo irrefrenable de sangre humana... se está convirtiendo en una mujer-lobo. Brigitte tiene que ayudar a su hermana y recurre a Sam, un joven enigmático, con fama de chico malo y muy aficionado a la botánica... Y mientras Brigitte lucha por proteger a Ginger, se convierte en cómplice de sus crímenes violentos e incontrolables","status":"Released","country":null,"genres":["Terror","Fantasía"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/9871","type":"flyflix","contentType":"movie","year":2000,"updatedAt":"2026-10-13T04:36:04.976Z"},{"id":"movie-1480665","slug":"movie-1480665","title":"Quasimodo, el alma de París","image":"https://image.tmdb.org/t/p/w300/iTWHDVKSSkL6njG8WDZxmwbBiiG.jpg","synopsis":"París, 1830. Mientras el cólera se extiende, un jorobado al que persiguen para hacer experimentos médicos con él se ve atrapado entre la inestabilidad política y un amor imposible.","status":"Post Production","country":null,"genres":["Drama","Romance"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1480665","type":"flyflix","contentType":"movie","year":2026,"updatedAt":"2026-10-13T04:36:05.330Z"},{"id":"movie-95","slug":"movie-95","title":"Armageddon","image":"https://image.tmdb.org/t/p/w300/yYtlk1E28L1kQG6VcazkHhv29Ur.jpg","synopsis":"Un asteroide del tamaño del estado de Texas apunta directamente hacia la Tierra. En la NASA, tan sólo encuentran una posible solución: enviar a un equipo de astronautas al espacio para que destruya el meteorito antes de que colisione con nuestro planeta. Para ello recurren a Harry S. Stamper, el mayor experto en perforaciones petrolíferas, y a su cualificado equipo de perforadores, para que aterricen en la superficie del asteroide, lo perforen e introduzcan un dispositivo nuclear que al estallar consiga desviar su trayectoria y poder salvar el planeta, evitando así el armagedón.","status":"Released","country":null,"genres":["Acción","Ciencia ficción","Aventura"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/95","type":"flyflix","contentType":"movie","year":1998,"updatedAt":"2026-10-13T04:36:05.683Z"},{"id":"movie-1700888","slug":"movie-1700888","title":"Hiddensee","image":"https://image.tmdb.org/t/p/w300/kPpq85C04samuCP3s9wty28LwmJ.jpg","synopsis":null,"status":"Released","country":null,"genres":["Documental"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1700888","type":"flyflix","contentType":"movie","year":2026,"updatedAt":"2026-10-13T04:36:06.082Z"},{"id":"movie-615656","slug":"movie-615656","title":"Megalodón 2: La fosa","image":"https://image.tmdb.org/t/p/w300/mBgynPDplmo5JTY9VfGqY35OjDu.jpg","synopsis":"Una exploración submarina en las profundidades del océano se convierte en una espiral de caos cuando una malévola operación minera amenaza la misión y obliga al equipo de investigación a librar una arriesgada batalla por la supervivencia. Secuela de 'The Meg' (2018).","status":"Released","country":null,"genres":["Acción","Ciencia ficción","Terror"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/615656","type":"flyflix","contentType":"movie","year":2023,"updatedAt":"2026-10-13T04:36:06.430Z"},{"id":"movie-1742809","slug":"movie-1742809","title":"藥命針愛","image":"https://image.tmdb.org/t/p/w300/csMa8H1aylkdwJHnTMTu8V9xEJw.