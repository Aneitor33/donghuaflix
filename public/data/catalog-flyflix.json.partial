ype":"flyflix","contentType":"movie","year":2006,"updatedAt":"2026-10-14T12:13:41.302Z"},{"id":"movie-324544","slug":"movie-324544","title":"Tierras perdidas","image":"https://image.tmdb.org/t/p/w300/sLDxndoqFWwJEq7iEdYQBzPjUDQ.jpg","synopsis":"Basada en el relato de George R. R. Martin. Una reina (Amara Okereke), desesperada por encontrar la felicidad en el amor, envía a la poderosa bruja Gray Alys (Milla Jovovich) a las Tierras Perdidas, en busca de un poder mágico que permite a una persona transformarse en un hombre lobo. Con el misterioso cazador Boyce (Dave Bautista), que la apoya en la lucha contra criaturas oscuras y despiadadas, Gray deambula por un mundo inquietante y peligroso. Pero solo ella sabe que, cada deseo que se concede, tiene consecuencias inimaginables.","status":"Released","country":null,"genres":["Acción","Fantasía","Western","Aventura","Terror"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/324544","type":"flyflix","contentType":"movie","year":2025,"updatedAt":"2026-10-14T12:13:41.580Z"},{"id":"movie-1395527","slug":"movie-1395527","title":"साले आशिक","image":"https://image.tmdb.org/t/p/w300/aZG7N30kkZkJ5MANcX578B1D9tj.jpg","synopsis":null,"status":"Released","country":null,"genres":["Romance","Drama"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1395527","type":"flyflix","contentType":"movie","year":2025,"updatedAt":"2026-10-14T12:13:41.858Z"},{"id":"movie-1591604","slug":"movie-1591604","title":"Soul Patrol","image":"https://image.tmdb.org/t/p/w300/sav8yadAjfykfFlZuFsclmrN9st.jpg","synopsis":null,"status":"Released","country":null,"genres":["Documental"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1591604","type":"flyflix","contentType":"movie","year":2026,"updatedAt":"2026-10-14T12:13:42.166Z"},{"id":"movie-1751676","slug":"movie-1751676","title":"UFC 331: Van vs. Pantoja 2","image":"https://image.tmdb.org/t/p/w300/72RsaYlA7M4VIFSdvUD23rWotus.jpg","synopsis":null,"status":"Released","country":null,"genres":["Acción"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1751676","type":"flyflix","contentType":"movie","year":2026,"updatedAt":"2026-10-14T12:13:42.439Z"},{"id":"movie-1752159","slug":"movie-1752159","title":"Momentos decisivos: Generación 11-S","image":"https://image.tmdb.org/t/p/w300/peEW3aQtOacOqGOB88LkDT6QGvQ.jpg","synopsis":"Veinticinco años después del 11-S, este documental analiza cómo aquel fatídico día marcó a toda una nueva generación. Desde los niños que perdieron a sus padres en los atentados a los periodistas que dieron sus primeros pasos profesionales cubriendo la guerra contra el terrorismo, pasando por los jóvenes afganos y marines que sufrieron las consecuencias de la caótica retirada de EE. UU. de Afganistán: sus estremecedores testimonios muestran que el legado del 11-S no se mide solo por su trascendencia histórica, sino por las vidas que aún sigue marcando.","status":"Released","country":null,"genres":["Documental"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1752159","type":"flyflix","contentType":"movie","year":2026,"updatedAt":"2026-10-14T12:13:42.711Z"},{"id":"movie-1553200","slug":"movie-1553200","title":"青春ブタ野郎はディアフレンドの夢を見ない","image":"https://image.tmdb.org/t/p/w300/iSG98AUNeBEol9GhoPVdPMxjpYb.jpg","synopsis":null,"status":"Released","country":null,"genres":["Animación","Drama","Misterio","Romance"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1553200","type":"flyflix","contentType":"movie","year":2026,"updatedAt":"2026-10-14T12:13:42.985Z"},{"id":"movie-1472940","slug":"movie-1472940","title":"Prisonnière","image":"https://image.tmdb.org/t/p/w300/xNMPl1JtoA3fVNJQGq1MmY97RM6.jpg","synopsis":null,"status":"Released","country":null,"genres":["Película de TV","Suspense"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1472940","type":"flyflix","contentType":"movie","year":2025,"updatedAt":"2026-10-14T12:13:43.257Z"},{"id":"movie-1205656","slug":"movie-1205656","title":"La c