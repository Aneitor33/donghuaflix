eventualmente sirvan para denunciar internacionalmente las atrocidades y mantener vivo el recuerdo histórico. La película, dirigida por Shen Ao y protagonizada por Liu Haoran entre otros, se basa en hechos reales y retrata la lucha por la supervivencia y la resistencia durante uno de los capítulos más oscuros de la historia china.","status":"Released","country":null,"genres":["Drama","Bélica","Historia"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1500536","type":"flyflix","contentType":"movie","year":2025,"updatedAt":"2026-10-22T12:10:22.487Z"},{"id":"movie-1563891","slug":"movie-1563891","title":"Mariage au goût d'orange","image":"https://image.tmdb.org/t/p/w300/xKcS1CVqOK1AgCjkb8Vcgja9FPA.jpg","synopsis":null,"status":"Released","country":null,"genres":["Drama","Comedia"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1563891","type":"flyflix","contentType":"movie","year":2026,"updatedAt":"2026-10-22T12:10:22.787Z"},{"id":"movie-1153399","slug":"movie-1153399","title":"கூலி","image":"https://image.tmdb.org/t/p/w300/kr36awqmziEI5mfUElsHB0pj9zP.jpg","synopsis":null,"status":"Released","country":null,"genres":["Acción","Suspense","Crimen"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1153399","type":"flyflix","contentType":"movie","year":2025,"updatedAt":"2026-10-22T12:10:23.090Z"},{"id":"movie-1423253","slug":"movie-1423253","title":"కొరియన్ కనకరాజు","image":"https://image.tmdb.org/t/p/w300/vUEb8v8W5ANRXhydogbmjXfRfni.jpg","synopsis":null,"status":"Released","country":null,"genres":["Comedia","Terror","Acción"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1423253","type":"flyflix","contentType":"movie","year":2026,"updatedAt":"2026-10-22T12:10:23.392Z"},{"id":"movie-1506912","slug":"movie-1506912","title":"Looney Tunes Collector's Vault Volume 1","image":"https://image.tmdb.org/t/p/w300/yTgLYhZdTXqww9d29ZMS3is8Ntw.jpg","synopsis":null,"status":"Released","country":null,"genres":[],"totalEpisodes":null,"sour