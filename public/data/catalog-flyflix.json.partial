lien.","status":"Released","country":null,"genres":["Terror","Ciencia ficción"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/945961","type":"flyflix","contentType":"movie","year":2024,"updatedAt":"2026-10-14T12:16:54.225Z"},{"id":"movie-1645603","slug":"movie-1645603","title":"La noche de los muertos vivientes. Estallido zombi","image":"https://image.tmdb.org/t/p/w300/9MQDHgtd9Tv2Jws1Ox357chtMYK.jpg","synopsis":"Remake de la película de terror de culto “La noche de los muertos vivientes” de George A. Romero de 1968. Tiene lugar durante un acontecimiento mundial en el que los muertos se alzan y vagan por la tierra como zombis. A medida que la civilización se derrumba, un pequeño grupo de supervivientes debe luchar para mantenerse con vida contra la creciente amenaza de los muertos vivientes.","status":"Released","country":null,"genres":["Terror"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1645603","type":"flyflix","contentType":"movie","year":2026,"updatedAt":"2026-10-14T12:16:54.521Z"},{"id":"movie-1413097","slug":"movie-1413097","title":"Melania","image":"https://image.tmdb.org/t/p/w300/xG3v5b3rIgudFoV2ceMiWE01F0q.jpg","synopsis":"Una crónica íntima ofrece una visión poco común de la vida de Melania Trump, explorando su papel como primera dama y su relación con el expresidente","status":"Released","country":null,"genres":["Documental"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1413097","type":"flyflix","contentType":"movie","year":2026,"updatedAt":"2026-10-14T12:16:54.795Z"},{"id":"movie-1521116","slug":"movie-1521116","title":"The Cowboy Killer","image":"https://image.tmdb.org/t/p/w300/uz2Jsr5yrkiJHuYK4yb8zSOzvJe.jpg","synopsis":null,"status":"Released","country":null,"genres":["Suspense"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1521116","type":"flyflix","contentType":"movie","year":2026,"updatedAt":"2026-10-14T12:16:55.069Z"},{"id":"movie-240","slug":"movie-240","title":"El padrino II","image":