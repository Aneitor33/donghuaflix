vie-1363979","title":"劇場版 僕の心のヤバイやつ","image":"https://image.tmdb.org/t/p/w300/m0SmTFThfKTMZMKxUsxc7vFUla.jpg","synopsis":null,"status":"Released","country":null,"genres":["Animación","Romance"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1363979","type":"flyflix","contentType":"movie","year":2026,"updatedAt":"2026-10-13T14:01:46.143Z"},{"id":"movie-1756286","slug":"movie-1756286","title":"Portrait of an Artist: Stephen Curry","image":"https://image.tmdb.org/t/p/w300/bKVscDx3dWrOwZuy0X1WMlOUNWN.jpg","synopsis":null,"status":"Released","country":null,"genres":["Documental"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1756286","type":"flyflix","contentType":"movie","year":2026,"updatedAt":"2026-10-13T14:01:46.439Z"},{"id":"movie-850439","slug":"movie-850439","title":"Los condenados","image":"https://image.tmdb.org/t/p/w300/23VdXxxHf9bWnmBWVB4rIsqDWuz.jpg","synopsis":"En el siglo XIX, una viuda tiene la tarea de tomar una decisión imposible cuando, durante un invierno especialmente cruel, un barco se hunde frente a la costa de su empobrecido pueblo pesquero islandés. Cualquier intento de rescatar a los supervivientes del naufragio corre el riesgo de agotar aún más los suministros de los aldeanos hambrientos.","status":"Released","country":null,"genres":["Terror","Drama","Misterio"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/850439","type":"flyflix","contentType":"movie","year":2025,"updatedAt":"2026-10-13T14:01:46.740Z"},{"id":"movie-1271","slug":"movie-1271","title":"300","image":"https://image.tmdb.org/t/p/w300/h7Lcio0c9ohxPhSZg42eTlKIVVY.jpg","synopsis":"Adaptación del cómic de Frank Miller (autor del cómic 'Sin City') sobre la famosa batalla de las Termópilas (480 a.C.). El objetivo de Jerjes, emperador de Persia, era la conquista de Grecia, lo que desencadenó las Guerras Médicas. Dada la gravedad de la situación, el rey Leónidas de Esparta (Gerard Butler) y 300 espartanos se enfrentaron a un ejército persa que era inmensamente superior.","status":"Released","country":null,"genres":["Acción","Aventura","Bélica"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1271","type":"flyflix","contentType":"movie","year":2007,"updatedAt":"2026-10-13T14:01:47.033Z"},{"id":"movie-1588846","slug":"movie-1588846","title":"Ekis","image":"https://image.tmdb.org/t/p/w300/vuUvGqqGabV422qzjGWPlhRuvN0.jpg","synopsis":null,"status":"Released","country":null,"genres":["Drama"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1588846","type":"flyflix","contentType":"movie","year":2025,"updatedAt":"2026-10-13T14:01:47.344Z"},{"id":"movie-587370","slug":"movie-587370","title":"Los misteriosos cuentos del manzano","image":"https://image.tmdb.org/t/p/w300/5h7X8auA7s0R4cm8nf3yD8OnC1.jpg","synopsis":"Tres niños, Tom (4), Susan (8) y Derek (10), pasan la noche en casa de su abuelo. Para llenar el silencio tras la pérdida de su querida abuela, la cuentacuentos de la familia, los pequeños crean sus propias historias y descubren el poder de la imaginación.","status":"Released","country":null,"genres":["Animación","Familia","Fantasía","Comedia"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/587370","type":"flyflix","contentType":"movie","year":2025,"updatedAt":"2026-10-13T14:01:47.639Z"},{"id":"movie-764","slug":"movie-764","title":"Posesión infernal","image":"https://image.tmdb.org/t/p/w300/vgQDogdqPrSk2zRdy2JESq2LGvy.jpg","synopsis":"Cinco chicos van a pasar el fin de semana a una cabaña perdida en un espeso bosque en las montañas de Tennessee. Una vez instalados, y cuando se encuentran cenando, la trampilla que da acceso al sótano se abre de golpe. Extrañados, deciden bajar a investigar. Allí encuentran un magnetófono, un extraño cuchillo ritual y un libro antiquísimo.","status":"Released","country":null,"genres":["Terror"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/764","type":"flyflix","contentType":"movie","year":1983,"updatedAt":"2026-10-13T14:01:47.930Z"},{"id":"movie-608067","slug":"movie-608067","title":"끝장수사","image":"https://image.tmdb.org/t/p/w300/5Ae26RGA7hLe4yYsjH0Q9PYCTLN.jpg","synopsis":null,"status":"Released","country":null,"genres":["Comedia","Crimen","Acción"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/608067","type":"flyflix","contentType":"movie","year":2026,"updatedAt":"2026-10-13T14:01:48.224Z"},{"id":"movie-1623125","slug":"movie-1623125","title":"Una historia de gorilas contada por David Attenborough","image":"https://image.tmdb.org/t/p/w300/clNFM3SfwVPZ8snSCnKVSPSdxWA.jpg","synopsis":"El conocido naturalista David Attenborough cuenta la historia de un asombroso grupo de gorilas, desde su primer encuentro con ellos en los años setenta hasta hoy.","status":"Released","country":null,"genres":["Documental"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1623125","type":"flyflix","contentType":"movie","year":2026,"updatedAt":"2026-10-13T14:01:48.519Z"},{"id":"movie-1741768","slug":"movie-1741768","title":"নিব্বা নিব্বি","image":"https://image.tmdb.org/t/p/w300/4Mbi8MAvBYYTUtxYFCmVDdsq1Pv.jpg","synopsis":null,"status":"Released","country":null,"genres":["Acción","Crimen","Comedia"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1741768","type":"flyflix","contentType":"movie","year":2026,"updatedAt":"2026-10-13T14:01:48.820Z"},{"id":"movie-1659087","slug":"movie-1659087","title":"180","image":"https://image.tmdb.org/t/p/w300/4nNuv41aosADsoQYYJDg7Y829YK.jpg","synopsis":"Un inesperado incidente de tráfico deja a su hijo en estado crítico. El padre, enfurecido, se adentra en una oscura espiral de confusión emocional y venganza.","status":"Released","country":null,"genres":["Suspense","Crimen","Drama","Película de TV"],"totalEpisodes":null,"sourceUrl":"https://flyflix.net/watch/1659087","type":"flyflix","contentType":"movie","year":2026,"updatedAt":"2026-10-13T14:01:49.115Z"},{"id":"movie-1512629","slug":"movie-1512629","title":"Biermann","image":"https://image.